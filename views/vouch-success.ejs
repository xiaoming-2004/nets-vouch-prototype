<%- include('partials/start', { title: 'Vouched' }) %>
<section class="share-vouch"><div class="success-mark" aria-hidden="true">✓</div><h1>Payment-Verified Vouch created</h1><p><%= transaction.merchantName %> · Verified NETS Visit</p>
<article class="share-preview"><small>NETS Vouch</small><h2><%= vouch.user %> Vouched for <%= transaction.merchantName %></h2><span><%= vouch.tagLabel %></span><span>✓ Payment-Verified</span></article>
<h2>Share with a friend</h2><div class="share-grid" data-share-path="<%= sharePath %>" data-share-merchant="<%= transaction.merchantName %>"><button type="button" data-share-platform="whatsapp"><b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z"/><path d="M9 8.5c.6 2.3 2.2 3.9 4.5 4.6"/></svg></b>WhatsApp</button><button type="button" data-share-platform="telegram"><b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 17-7-4 16-5-6-4 3 1-5Z"/><path d="m8 12 8-5"/></svg></b>Telegram</button><button type="button" data-share-platform="copy"><b><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg></b>Copy Link</button></div><p class="share-status" role="status"></p><small>Your payment amount stays private.</small>
<form method="POST" action="/transactions/<%= transaction.id %>/done"><button class="button" type="submit">Done</button></form></section>
<%- include('partials/end', { active: transaction.journeySource === 'scan' ? 'scan' : 'home' }) %>
