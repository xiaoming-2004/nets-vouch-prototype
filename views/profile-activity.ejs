<%- include('partials/start', { title: 'NETS Activity' }) %>
<a class="back" href="/profile">← Profile</a>
<h1>NETS Activity</h1>
<p>Your completed NETS payments.</p>
<% if (!transactions.length) { %>
<section class="card state-card"><div class="state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg></div><h2>No NETS activity yet.</h2><p>Your completed payments will appear here.</p><a class="button" href="/scan">Scan to pay</a></section>
<% } else { %>
<div class="activity-list">
<% transactions.forEach(function(transaction) { %>
<a class="payment-row" href="/transactions/<%= transaction.id %>">
  <span class="merchant-badge"><%= transaction.merchantName.charAt(0) %></span>
  <span>
    <strong><%= transaction.merchantName %></strong>
    <small><%= transaction.date %> · <%= transaction.time %></small>
    <em>NETS · Successful</em>
    <% if (transaction.merchantCreditUsed > 0) { %><small><%= transaction.merchantName %> Vouch Credit used: $<%= transaction.merchantCreditUsed.toFixed(2) %></small><% } %>
  </span>
  <b>$<%= transaction.netsPaid.toFixed(2) %>
    <% if (transaction.merchantRewardEarned > 0) { %><small>+$<%= transaction.merchantRewardEarned.toFixed(2) %> Vouch Credit</small><% } %>
  </b>
</a>
<% }); %>
</div>
<% } %>
<%- include('partials/end', { active: 'activity' }) %>
