<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Jia's NETS Vouch AI recommendation feedback">
    <meta name="theme-color" content="#083b66">
    <title>Recommendation Feedback | NETS Vouch AI</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main class="prototype-stage">
      <section class="phone-shell" aria-label="NETS Vouch AI prototype">
        <div class="status-bar" aria-hidden="true">
          <span>9:41</span>
          <span class="status-bar__island"></span>
          <span class="status-bar__signals">● ◢ ▰</span>
        </div>
        <%- include('partials/jia-nav', { active: 'home' }) %>

        <header class="app-bar">
          <div class="wordmark" aria-label="NETS Vouch">
            <span class="wordmark__nets">NETS</span>
            <span class="wordmark__vouch">Vouch</span>
          </div>
          <span class="prototype-label">Prototype</span>
        </header>

        <div class="phone-viewport">
          <div class="screen screen--rejection">
            <header class="recommendation-heading">
              <a class="icon-button" href="/home" aria-label="Back to Home">←</a>
              <div>
                <p class="eyebrow">One tap — no typing</p>
                <h1>What did not fit?</h1>
              </div>
            </header>

            <p class="rejection-current">
              About <strong><%= currentRecommendation.itemName %></strong> from
              <%= currentRecommendation.merchantName %>
            </p>

              <div class="rejection-intro">
              <span aria-hidden="true">↻</span>
              <p>Tell us what missed the mark and we’ll find something better.</p>
            </div>

            <form class="rejection-form" method="POST" action="/recommendation/reject">
              <fieldset>
                <legend>Choose one reason</legend>

                <div class="rejection-grid">
                  <% rejectionReasons.forEach(function(reason) { %>
                    <input
                      class="rejection-radio"
                      type="radio"
                      name="reason"
                      id="reason-<%= reason.id %>"
                      value="<%= reason.id %>"
                      required
                    >
                    <label class="rejection-option" for="reason-<%= reason.id %>">
                      <span><%= reason.label %></span>
                      <span aria-hidden="true">→</span>
                    </label>
                  <% }); %>
                </div>
              </fieldset>

              <div class="screen-actions screen-actions--bottom">
                <button class="button button--full" type="submit">Find something better</button>
                <a class="back-home-link" href="/home">Back to Home</a>
              </div>
            </form>
          </div>
        </div>

        <div class="home-indicator" aria-hidden="true"></div>
      </section>
    </main>

    <script src="/js/script.js"></script>
  </body>
</html>
