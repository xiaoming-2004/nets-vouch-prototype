<%- include('partials/start', { title: 'Home', page: 'home' }) %>
<% var savedDiet = ['none', 'halal', 'vegetarian', 'vegan'].indexOf(profile.dietaryPreference) !== -1 ? profile.dietaryPreference : 'none'; %>
<div class="sheet-modal" data-match-modal data-modal-auto="<%= showOnboarding && !recommendation ? 'true' : 'false' %>" hidden>
<div class="sheet-modal__backdrop" data-modal-close></div>
<div class="sheet-modal__panel" role="dialog" aria-modal="true" aria-labelledby="sheet-title" tabindex="-1" data-modal-panel>
<button class="sheet-modal__close" type="button" data-modal-close aria-label="Close matching sheet"><span aria-hidden="true">×</span></button>
<form class="nl-form" data-nl-form novalidate>
  <p class="sheet-eyebrow">Hi <%= user.name %> 👋</p>
  <h2 class="sheet-title" id="sheet-title">What are you in the mood for?</h2>
  <label for="nl-text">What are you craving?</label>
  <div class="nl-controls">
    <input id="nl-text" name="text" type="text" maxlength="200" autocomplete="off" placeholder="e.g. chicken rice, something light…" aria-describedby="nl-hint nl-status">
  </div>
  <fieldset class="chip-group" role="group" aria-labelledby="food-chip-title" data-chip-group="food" data-chip-default="any">
    <legend class="chip-title" id="food-chip-title">Or pick a type</legend>
    <div class="chip-grid chip-grid--food">
      <% foodChoiceOptions.forEach(function(option) { %><button type="button" class="chip" data-chip-value="<%= option.value %>" aria-pressed="<%= option.value === 'any' ? 'true' : 'false' %>"><%= option.label %></button>
      <% }); %>
    </div>
  </fieldset>
  <fieldset class="chip-group" role="group" aria-labelledby="diet-chip-title" data-chip-group="dietary" data-chip-default="<%= savedDiet %>">
    <legend class="chip-title" id="diet-chip-title">Any dietary requirements?</legend>
    <div class="chip-grid chip-grid--diet">
      <% dietaryPreferenceOptions.forEach(function(option) { %><button type="button" class="chip" data-chip-value="<%= option.value %>" aria-pressed="<%= option.value === savedDiet ? 'true' : 'false' %>"><%= option.label %></button>
      <% }); %>
    </div>
  </fieldset>
  <button class="button" type="submit" data-nl-submit>Find my match</button>
  <p class="nl-status" id="nl-status" data-nl-status role="status" aria-live="polite" hidden></p>
  <div class="nl-understood" data-nl-understood hidden></div>
  <details class="about-search"><summary>About this search</summary>
    <p class="field-hint" id="nl-hint">AI interprets your words; fixed rules choose merchants. Up to 200 characters.</p>
    <p class="field-hint chip-hint">Ticked choices are your defaults. Only choices you change apply to this search; your saved profile is not changed.</p>
  </details>
</form>
</div>
</div>
<% if (resetComplete) { %><p class="badge badge--verified" role="status">✓ Demo reset successfully.</p><% } %>
<% if (settingsError) { %><p class="error" role="status">Please choose valid filters.</p><% } %>
<header class="greeting"><p><%= homeGreeting.greeting %>, <%= user.name %> 👋</p><h1><%= homeGreeting.prompt %></h1></header>
<section class="origin-panel" data-origin-panel<% if (mapsBrowserKey) { %> data-maps-browser-key="<%= mapsBrowserKey %>"<% } %> aria-labelledby="origin-title">
  <h2 id="origin-title" class="visually-hidden">Starting point</h2>
  <button class="origin-pill" type="button" data-origin-toggle aria-expanded="false" aria-controls="origin-choices"><svg class="origin-pill__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span class="origin-pill__text"><span class="origin-pill__label">Starting point</span><strong data-origin-pill>RP demo origin</strong></span><span class="origin-pill__chevron" aria-hidden="true"></span></button>
  <div class="origin-choices" id="origin-choices">
    <p class="origin-mode" data-origin-mode>RP demo origin: estimated distances, not routed walking times.</p>
    <div class="origin-actions">
      <button class="button" type="button" data-origin-device>Use my location</button>
      <button class="button" type="button" data-origin-place>Search for a place</button>
      <button class="text-button" type="button" data-origin-demo hidden>Use RP demo origin</button>
    </div>
    <div class="origin-search" data-origin-search hidden></div>
    <details class="origin-info"><summary>About starting points and privacy</summary><p class="field-hint">Choose a Singapore starting point to see Google Maps walking times. Your location is used only in this browser tab: it is sent to our server for that request and to Google Maps to calculate routes, and it is not saved.</p></details>
  </div>
  <p class="origin-status" data-origin-status role="status" aria-live="polite" hidden></p>
</section>
<section id="smart-match" aria-labelledby="results-title">
<div class="match-bar"><h2 class="match-bar__title" id="results-title">Your smart match</h2><button class="match-bar__edit" type="button" data-sheet-open aria-haspopup="dialog">Edit match</button></div>
<div data-match-region data-location-ready="<%= locationAttempted ? 'true' : 'false' %>" aria-live="polite" aria-busy="<%= recommendation || showOnboarding ? 'false' : 'true' %>">
<% if (recommendation) { %><%- include('smart-match-card') %><% } else if (showOnboarding) { %>
<section class="card state-card" data-state-card><div class="state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg></div><h2>Ready to find lunch?</h2><p>Tell us what you feel like and we will match you.</p><button class="button" type="button" data-sheet-open aria-haspopup="dialog">Find food</button></section>
<% } else { %>
<div class="matching" data-load-match><div class="matching-spinner" aria-hidden="true"></div><h2 data-matching-title><%= matchingAgain ? 'Finding something better…' : 'Finding catalogue matches…' %></h2><p data-matching-sub><%= matchingAgain ? 'Using your feedback' : 'Checking stored catalogue information' %></p><div class="skeleton" aria-hidden="true"><i></i><i></i><i></i></div></div>
<noscript><a class="button" href="/smart-match/static">Find my match</a></noscript>
<% } %>
</div></section>
<details class="filters-panel" data-filters-panel>
<summary class="filters-summary"><span class="filters-summary__title">Edit filters</span><span class="filter-chips" aria-label="Current filters"><span class="filter-chip"><%= dietaryPreferenceOptions.filter(function(o) { return o.value === savedDiet; }).map(function(o) { return o.label; })[0] %></span><span class="filter-chip">≤ $<%= profile.budget %></span><span class="filter-chip" data-filter-time></span></span></summary>
<form class="dining-time-form" data-dining-time-form>
  <label for="dining-date-time">When do you plan to eat?</label>
  <div class="dining-time-controls">
    <input id="dining-date-time" name="diningDateTime" type="datetime-local" value="<%= diningDateTime %>" required>
    <button class="button" type="submit">Update matches</button>
  </div>
  <p class="field-hint">Singapore date and time · distances are demo-origin estimates, not routed walking times.</p>
</form>
<form class="filters-form" method="POST" action="/profile">
  <label class="field">Budget (max $)<input name="budget" type="number" inputmode="decimal" min="1" max="100" step="1" value="<%= profile.budget %>"></label>
  <label class="field">Walking distance (max min)<input name="maxDistanceMinutes" type="number" inputmode="numeric" min="1" max="60" step="1" value="<%= profile.maxDistanceMinutes %>"></label>
  <button class="button" type="submit">Apply and find a new match</button>
  <p class="field-hint">Applying budget or distance reloads this page and returns to the RP demo origin.</p>
</form>
</details>
<%- include('partials/end', { active: 'home' }) %>
