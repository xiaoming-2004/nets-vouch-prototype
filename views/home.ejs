<%- include('partials/start', { title: 'Home', page: 'home' }) %>
<% if (showOnboarding) { %>
<div class="onboard-overlay" role="dialog" aria-modal="true" aria-labelledby="onboard-title">
  <div class="onboard-sheet">
    <p class="eyebrow">Hi <%= user.name %> 👋</p>
    <h2 id="onboard-title">What are you in the mood for?</h2>
    <form method="POST" action="/setup-preferences" class="onboard-form">
      <label class="field onboard-field">What are you craving?
        <input type="text" name="craving" placeholder="e.g. chicken rice, biryani, something light…" maxlength="100" autocomplete="off" autofocus>
      </label>
      <p class="onboard-or">Or pick a type</p>
      <div class="mood-grid">
        <% moodCuisineOptions.forEach(function(opt) { %>
        <label class="mood-chip">
          <input type="radio" name="moodCuisine" value="<%= opt.value %>" <%= opt.value === 'any' ? 'checked' : '' %>>
          <span><%= opt.label %></span>
        </label>
        <% }); %>
      </div>
      <label class="field onboard-field">Dietary requirements
        <select name="dietaryPreference">
          <% dietaryPreferenceOptions.forEach(function(opt) { %>
          <option value="<%= opt.value %>"><%= opt.label %></option>
          <% }); %>
        </select>
      </label>
      <button class="button" type="submit">Find my match →</button>
    </form>
  </div>
</div>
<% } %>
<% if (resetComplete) { %><p class="badge badge--verified" role="status">✓ Demo reset successfully.</p><% } %>
<header class="greeting"><p><%= homeGreeting.greeting %>, <%= user.name %> 👋</p><h1><%= homeGreeting.prompt %></h1></header>
<section id="smart-match"><p class="eyebrow">Your Smart Match</p>
<div data-match-region data-location-ready="<%= locationAttempted ? 'true' : 'false' %>" aria-live="polite" aria-busy="<%= recommendation ? 'false' : 'true' %>">
<% if (recommendation) { %><%- include('smart-match-card') %><% } else if (!showOnboarding) { %>
<div class="matching" data-load-match><div class="matching-spinner" aria-hidden="true"></div><h2 data-matching-title><%= matchingAgain ? 'Finding something better…' : 'Finding nearby places…' %></h2><p data-matching-sub><%= matchingAgain ? 'Using your feedback' : 'Checking what\'s around you right now' %></p><div class="skeleton" aria-hidden="true"><i></i><i></i><i></i></div></div>
<noscript><a class="button" href="/smart-match/static">Find my match</a></noscript>
<% } %>
</div></section>
<%- include('partials/end', { active: 'home' }) %>
