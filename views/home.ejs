<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Jia's NETS Vouch AI Smart Match">
    <meta name="theme-color" content="#082f5b">
    <title>Home | NETS Vouch AI</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main class="prototype-stage">
      <section class="phone-shell" aria-label="NETS Vouch AI prototype">
        <div class="status-bar" aria-hidden="true">
          <span>9:41</span>
          <span class="status-bar__island"></span>
          <span class="status-bar__signals">● ◢ ▰</span>
        </div>
        <header class="app-bar smart-home-bar">
          <div class="wordmark" aria-label="NETS Vouch AI">
            <span class="wordmark__nets">NETS</span>
            <span class="wordmark__vouch">Vouch AI</span>
          </div>
          <a class="smart-home-avatar" href="/profile" aria-label="Open Jia's profile"><%= user.name.charAt(0) %></a>
        </header>
        <div class="phone-viewport phone-viewport--home">
          <div class="home-layout">
            <div class="home-scroll">
              <div class="screen smart-home-screen">
                <header class="smart-home-intro">
                  <p>Good afternoon, <%= user.name %> <span aria-hidden="true">👋</span></p>
                  <h1>Lunch in 10 minutes?</h1>
                </header>
                <section id="smart-match" class="smart-match-section" aria-labelledby="smart-match-title">
                  <p id="smart-match-title" class="smart-match-label">Your Smart Match</p>
                  <div class="smart-match-region" data-smart-match data-loading-message="<%= matchingAgain ? 'Finding something better...' : 'Finding your next spot...' %>" aria-live="polite" aria-busy="true">
                    <div class="smart-match-loading">
                      <div class="smart-match-loading__visual" aria-hidden="true"><span></span><span></span><span></span></div>
                      <h2><%= matchingAgain ? 'Finding something better...' : 'Finding your next spot...' %></h2>
                      <p data-loading-detail><%= matchingAgain ? 'Using your feedback' : 'Checking what fits right now' %></p>
                    </div>
                  </div>
                </section>
              </div>
            </div>
            <nav class="bottom-navigation" aria-label="Primary navigation">
              <a class="bottom-navigation__item bottom-navigation__item--active" href="/home" aria-current="page"><span aria-hidden="true">⌂</span><span>Home</span></a>
              <a class="bottom-navigation__item" href="/scan"><span aria-hidden="true">⌗</span><span>Scan</span></a>
              <a class="bottom-navigation__item" href="/profile"><span aria-hidden="true">○</span><span>Profile</span></a>
            </nav>
          </div>
        </div>
        <div class="home-indicator" aria-hidden="true"></div>
      </section>
    </main>
    <script src="/js/script.js"></script>
  </body>
</html>
