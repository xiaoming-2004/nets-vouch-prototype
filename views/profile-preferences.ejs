<%- include('partials/start', { title: 'Preferences' }) %>
<a class="back" href="/profile">← Profile</a><h1>Preferences</h1><p>Shape what Smart Match shows you.</p>
<% if (settingsError) { %><p class="error">Please choose valid settings.</p><% } %>
<form method="POST" action="/profile" class="preferences-form form-stack"><label class="field">Dietary preference<select name="dietaryPreference"><% dietaryPreferenceOptions.forEach(function(option) { %><option value="<%= option.value %>" <%= profile.dietaryPreference === option.value ? 'selected' : '' %>><%= option.label %></option><% }); %></select></label><label class="field">Budget ($)<input type="number" name="budget" value="<%= profile.budget.toFixed(2) %>" min="1" max="100" step=".01" required></label><label class="field">Maximum walk (minutes)<input type="number" name="maxDistanceMinutes" value="<%= profile.maxDistanceMinutes %>" min="1" max="60" required></label><label class="cashback-toggle"><span>Notifications<br><small>Payment and reward updates</small></span><input type="checkbox" name="notifications" <%= profile.notifications ? 'checked' : '' %>></label><button class="button" type="submit">Save preferences</button></form>
<%- include('partials/end', { active: 'profile' }) %>