<%- include('partials/start', { title: 'Preferences' }) %>
<a class="back" href="/profile">← Profile</a><h1>Preferences</h1><p>Shape what Smart Match shows you.</p>
<% if (settingsError) { %><p class="error">Please choose valid settings.</p><% } %>
<form method="POST" action="/profile" class="preferences-form form-stack"><div class="field"><span class="field-label">Dietary preference</span><div class="mood-grid mood-grid--2"><% dietaryPreferenceOptions.forEach(function(option) { %><label class="mood-chip"><input type="radio" name="dietaryPreference" value="<%= option.value %>" <%= profile.dietaryPreference === option.value ? 'checked' : '' %>><span><%= option.label %></span></label><% }); %></div></div><div class="field"><span class="field-label">Mood today</span><div class="mood-grid"><% moodCuisineOptions.forEach(function(opt) { %><label class="mood-chip"><input type="radio" name="moodCuisine" value="<%= opt.value %>" <%= (profile.moodCuisine || 'any') === opt.value ? 'checked' : '' %>><span><%= opt.label %></span></label><% }); %></div></div><label class="field">Budget ($)<input type="number" name="budget" value="<%= profile.budget.toFixed(2) %>" min="1" max="100" step=".01" required></label><label class="field">Maximum walk (minutes)<input type="number" name="maxDistanceMinutes" value="<%= profile.maxDistanceMinutes %>" min="1" max="60" required></label><label class="cashback-toggle"><span>Notifications<br><small>Payment and reward updates</small></span><input type="checkbox" name="notifications" <%= profile.notifications ? 'checked' : '' %>></label><button class="button" type="submit">Save preferences</button></form>
<%- include('partials/end', { active: 'profile' }) %>