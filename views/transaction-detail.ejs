<%- include('partials/start', { title: 'Transaction' }) %>
<a class="back" href="/profile?tab=transactions">← NETS Activity</a><p class="eyebrow"><%= transaction.source === 'scan' ? 'In-store payment' : 'Smart Match collection order' %></p><h1><%= transaction.merchantName %></h1><p>Successful ✓</p>
<dl class="receipt-lines card"><div><dt>Purchase</dt><dd>$<%= transaction.purchaseAmount.toFixed(2) %></dd></div><div><dt>Cashback used</dt><dd>−$<%= transaction.cashbackUsed.toFixed(2) %></dd></div><div><dt>Paid with NETS</dt><dd>$<%= transaction.netsPaid.toFixed(2) %></dd></div><div><dt>Cashback earned</dt><dd>$<%= transaction.cashbackAwarded.toFixed(2) %></dd></div><div><dt>Merchant outlet</dt><dd><%= transaction.outlet %></dd></div><div><dt>Date / time</dt><dd><%= transaction.date %><br><%= transaction.time %></dd></div><div><dt>Transaction</dt><dd><%= transaction.id %></dd></div><div><dt>Vouch</dt><dd><%= transaction.vouchDecision %></dd></div></dl>
<% if (transaction.vouchDecision === 'pending' && (transaction.source === 'scan' || transaction.collected)) { %><a class="button" href="/vouch/<%= transaction.id %>">Vouch this spot</a><% } %>
<%- include('partials/end', { active: 'profile' }) %>
