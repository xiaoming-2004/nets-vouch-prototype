<%- include('partials/start', { title: 'Transaction' }) %>
<a class="back" href="/profile/activity">← NETS Activity</a><div class="transaction-head"><span class="success-mini">✓</span><p>Successful</p><h1><%= transaction.merchantName %></h1></div>
<dl class="receipt-lines"><div><dt>Purchase</dt><dd>$<%= transaction.purchaseAmount.toFixed(2) %></dd></div><div><dt><%= transaction.merchantName %> Vouch Credit</dt><dd>−$<%= transaction.merchantCreditUsed.toFixed(2) %></dd></div><div><dt>Paid with NETS</dt><dd>$<%= transaction.netsPaid.toFixed(2) %></dd></div><div><dt>Reward earned</dt><dd class="positive">+$<%= transaction.merchantRewardEarned.toFixed(2) %></dd></div></dl><p class="transaction-date"><%= transaction.date %> · <%= transaction.time %></p>
<% if (transaction.vouchDecision === 'pending' && transaction.journeySource === 'scan') { %><a class="button" href="/vouch/<%= transaction.id %>">Vouch this spot</a><% } %>
<%- include('partials/end', { active: 'profile' }) %>
