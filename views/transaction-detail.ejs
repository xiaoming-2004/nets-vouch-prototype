<%- include('partials/start', { title: 'Transaction' }) %>
<a class="back" href="/profile?tab=transactions">← NETS Activity</a><p class="eyebrow">In-store payment</p><h1><%= transaction.merchantName %></h1><p>Successful ✓</p>
<dl class="receipt-lines card"><div><dt>Purchase</dt><dd>$<%= transaction.purchaseAmount.toFixed(2) %></dd></div><div><dt>Merchant credit used</dt><dd>−$<%= transaction.merchantCreditUsed.toFixed(2) %></dd></div><div><dt>Paid with NETS</dt><dd>$<%= transaction.netsPaid.toFixed(2) %></dd></div><div><dt>Vouch Credit earned</dt><dd>$<%= transaction.merchantRewardEarned.toFixed(2) %></dd></div><div><dt>Source</dt><dd><%= transaction.source %></dd></div><div><dt>Merchant outlet</dt><dd><%= transaction.outlet %></dd></div><div><dt>Date / time</dt><dd><%= transaction.date %><br><%= transaction.time %></dd></div><div><dt>Transaction</dt><dd><%= transaction.id %></dd></div><div><dt>Vouch</dt><dd><%= transaction.vouchDecision %></dd></div></dl>
<% if (transaction.vouchDecision === 'pending' && transaction.journeySource === 'scan') { %><a class="button" href="/vouch/<%= transaction.id %>">Vouch this spot</a><% } %>
<%- include('partials/end', { active: 'profile' }) %>
