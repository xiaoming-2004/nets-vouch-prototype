<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Jia's simulated NETS Vouch AI smart recommendation">
    <meta name="theme-color" content="#083b66">
    <title>Smart Recommendation | NETS Vouch AI</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main class="prototype-stage">
      <section class="phone-shell" aria-label="NETS Vouch AI prototype">
        <div class="status-bar" aria-hidden="true">
          <span>9:41</span>
          <span class="status-bar__island"></span>
          <span class="status-bar__signals">● ◢ ▰</span>
        </div>

        <header class="app-bar">
          <div class="wordmark" aria-label="NETS Vouch">
            <span class="wordmark__nets">NETS</span>
            <span class="wordmark__vouch">Vouch</span>
          </div>
          <span class="prototype-label">Prototype</span>
        </header>

        <div class="phone-viewport">
          <div class="screen screen--recommendation">
            <header class="recommendation-heading">
              <a class="icon-button" href="/home" aria-label="Back to Home">←</a>
              <div>
                <p class="eyebrow">Your Smart Match</p>
                <h1>Worth a look</h1>
              </div>
            </header>

            <section class="smart-match-summary" aria-label="Profile preferences used for Smart Match">
              <strong>Matched for <%= user.name %></strong>
                <span><%= dietaryPreferenceLabel %> · Up to $<%= profile.budget.toFixed(2) %> · <%= profile.maxDistanceMinutes %> min walk</span>
            </section>

            <% if (rejectionNote) { %>
              <div class="learning-banner">
                <span class="learning-banner__icon" aria-hidden="true">✦</span>
                <span><strong>Adjusted</strong><%= rejectionNote %></span>
              </div>
            <% } %>

            <article class="recommendation-card" data-recommendation-id="<%= recommendation.id %>">
              <div class="recommendation-card__visual" aria-hidden="true">
                <span><%= recommendation.dietary.includes('vegan') ? '🥗' : recommendation.category === 'noodles' ? '🍜' : '🍚' %></span>
                <small><%= recommendation.address %></small>
              </div>

              <div class="recommendation-card__body">
                <p class="eyebrow"><%= campaign ? 'Participating merchant' : 'Nearby discovery' %></p>
                <h2><%= recommendation.merchantName %></h2>
                <p class="recommendation-card__item"><%= recommendation.itemName %></p>

                <div class="recommendation-facts" aria-label="Recommendation details">
                  <% if (recommendation.price !== null) { %><span><strong>$<%= recommendation.price.toFixed(2) %></strong> approximate price</span><% } %>
                  <% recommendation.dietary.forEach(function(dietaryTag) { %>
                    <span><strong><%= dietaryTag.charAt(0).toUpperCase() + dietaryTag.slice(1) %></strong> dietary</span>
                  <% }); %>
                  <span><strong><%= recommendation.distanceMinutes %>-minute</strong> walk</span>
                </div>

                <% if (campaign) { %>
                  <p class="cashback-chip"><strong>$<%= campaign.rewardAmount.toFixed(2) %> cashback</strong> after eligible NETS payment</p>
                <% } %>

                <div class="match-reason">
                  <span aria-hidden="true">✦</span>
                  <div><strong>Why this match</strong><ul><% matchReasons.forEach(function(reason) { %><li><%= reason %></li><% }); %></ul></div>
                </div>
              </div>
            </article>

            <p class="verification-note">
              Nearby discovery does not mean a merchant participates in NETS Vouch AI. Vouch details only appear for an internal prototype campaign.
            </p>

            <p class="prototype-match-note">Simulated Smart Match · No live AI model or production data access</p>

            <div class="screen-actions screen-actions--bottom">
              <% if (recommendationAccepted && journeyLink) { %>
                <a class="button button--full" href="<%= journeyLink %>">Continue Vouch journey</a>
              <% } else if (canContinueJourney) { %>
                <form method="POST" action="/recommendation/accept">
                  <button class="button button--full" type="submit">Accept &amp; pay</button>
                </form>
              <% } else { %>
                <button class="button button--full" type="button" disabled>Nearby discovery only</button>
              <% } %>
              <% if (!recommendationAccepted) { %>
                <a class="button button--ghost button--full" href="/recommendation/reject">Not for me</a>
              <% } %>
              <a class="back-home-link" href="/home">Back to Home</a>
            </div>
          </div>
        </div>

        <div class="home-indicator" aria-hidden="true"></div>
      </section>
    </main>

    <script src="/js/script.js"></script>
  </body>
</html>
