<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Jia's simulated NETS Vouch AI smart recommendation">
    <meta name="theme-color" content="#083b66">
    <title>Smart Recommendation | NETS Vouch AI</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main class="prototype-stage">
      <section class="phone-shell" aria-label="NETS Vouch AI prototype">
        <div class="status-bar" aria-hidden="true">
          <span>9:41</span>
          <span class="status-bar__island"></span>
          <span class="status-bar__signals">● ◢ ▰</span>
        </div>

        <header class="app-bar">
          <div class="wordmark" aria-label="NETS Vouch">
            <span class="wordmark__nets">NETS</span>
            <span class="wordmark__vouch">Vouch</span>
          </div>
          <span class="prototype-label">Prototype</span>
        </header>

        <div class="phone-viewport">
          <div class="screen screen--recommendation">
            <header class="recommendation-heading">
              <a class="icon-button" href="/home" aria-label="Back to Home">←</a>
              <div>
                <p class="eyebrow">
                  <%= personalisation.transactionAnalysis ? 'Vouch AI smart match' : 'Basic Mode smart match' %>
                </p>
                <h1>One lunch option</h1>
              </div>
            </header>

            <section
              class="recommendation-mode <%= personalisation.transactionAnalysis ? 'recommendation-mode--personalised' : 'recommendation-mode--basic' %>"
              aria-label="Recommendation mode"
            >
              <strong><%= personalisation.transactionAnalysis ? 'Personalised Mode' : 'Basic Mode' %></strong>
              <% if (personalisation.transactionAnalysis && personalisation.location) { %>
                <span>For <%= user.name %> · Uses permitted prototype preferences, activity patterns and location.</span>
              <% } else if (personalisation.transactionAnalysis) { %>
                <span>For <%= user.name %> · Uses permitted prototype preferences and activity patterns. Location is off.</span>
              <% } else if (personalisation.location) { %>
                <span>For <%= user.name %> · Uses allowed preferences and location. No transaction-history analysis.</span>
              <% } else { %>
                <span>For <%= user.name %> · Uses allowed preferences only. No transaction-history analysis or location.</span>
              <% } %>
            </section>

            <% if (rejectionNote) { %>
              <div class="learning-banner">
                <span class="learning-banner__icon" aria-hidden="true">✦</span>
                <span><strong>Adjusted</strong><%= rejectionNote %></span>
              </div>
            <% } %>

            <article class="recommendation-card" data-recommendation-id="<%= recommendation.id %>">
              <div class="recommendation-card__visual" aria-hidden="true">
                <span>🏪</span>
                <small><%= recommendation.availability %></small>
              </div>

              <div class="recommendation-card__body">
                <p class="eyebrow">Participating merchant</p>
                <h2><%= recommendation.merchantName %></h2>
                <p class="recommendation-card__item"><%= recommendation.itemName %></p>

                <div class="recommendation-facts" aria-label="Recommendation details">
                  <span><strong>$<%= recommendation.price.toFixed(2) %></strong> price</span>
                  <% if (recommendation.halal) { %>
                    <span><strong>Halal</strong> dietary</span>
                  <% } %>
                  <% if (personalisation.location) { %>
                    <span><strong><%= recommendation.distanceMinutes %>-minute</strong> walk</span>
                  <% } %>
                </div>

                <p class="cashback-chip">
                  <strong>$<%= recommendation.cashback.toFixed(2) %> cashback</strong>
                  after eligible NETS payment
                </p>

                <p class="verified-vouches">
                  <span aria-hidden="true">✓</span>
                  <strong><%= recommendation.vouchCount %></strong> Payment-Verified Vouches
                </p>

                <div class="match-reason">
                  <span aria-hidden="true">✦</span>
                  <p><strong>Why this match</strong><%= matchReason %></p>
                </div>
              </div>
            </article>

            <p class="verification-note">
              A Verified Vouch confirms an eligible payment, not guaranteed quality.
            </p>

            <p class="prototype-match-note">Simulated Smart Match · No live AI model or production data access</p>

            <div class="screen-actions screen-actions--bottom">
              <% if (currentOrder) { %>
                <a class="button button--full" href="/order">View current order</a>
              <% } else { %>
                <form method="POST" action="/recommendation/accept">
                  <button class="button button--full" type="submit">Accept and pay</button>
                </form>
              <% } %>
              <a class="button button--ghost button--full" href="/recommendation/reject">Not for me</a>
              <a class="back-home-link" href="/home">Back to Home</a>
            </div>
          </div>
        </div>

        <div class="home-indicator" aria-hidden="true"></div>
      </section>
    </main>

    <script src="/js/script.js"></script>
  </body>
</html>
