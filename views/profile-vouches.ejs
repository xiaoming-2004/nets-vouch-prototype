<%- include('partials/start', { title: 'My Vouches' }) %>
<a class="back" href="/profile">← Profile</a><h1>My Vouches</h1><p>Places you visited and Vouched for.</p>
<% if (!paymentVerifiedVouches.length) { %><section class="card state-card"><div class="state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></div><h2>No Vouches yet</h2><p>Your first Vouch starts with a NETS payment.</p><a class="button" href="/home">Find a spot</a></section><% } %>
<div class="vouch-list"><% paymentVerifiedVouches.forEach(function(vouch) { %><article class="vouch-row"><span class="merchant-badge"><%= vouch.merchantName.charAt(0) %></span><div><h2><%= vouch.merchantName %></h2><p>✓ Payment-Verified</p><small><% if (vouch.tagLabel !== 'Payment-Verified') { %><%= vouch.tagLabel %> · <% } %><%= vouch.date %></small><br><a href="/vouch/<%= vouch.transactionId %>/success">Share again</a></div></article><% }); %></div>
<%- include('partials/end', { active: 'profile' }) %>