<%- include('partials/start', { title: 'Scan to Pay' }) %>
<header class="page-heading">
  <h1>Scan to Pay</h1>
  <p>Tap a participating merchant to scan their NETS QR.</p>
</header>
<% if (error) { %><p class="error" role="alert">That QR wasn't recognised. Try a participating merchant.</p><% } %>

<div class="scan-merchants">
<% merchants.forEach(function(m) { var isActive = activeMerchantId === m.id; %>
<form method="POST" action="/scan" data-scan>
  <input type="hidden" name="merchantId" value="<%= m.id %>">
  <button type="submit" class="scan-merchant-row<%= isActive ? ' scan-merchant-row--active' : '' %>">
    <span class="scan-merchant-mono"><%= m.merchantName.charAt(0) %></span>
    <span class="scan-merchant-info">
      <strong><%= m.merchantName %></strong>
      <span><%= m.address %> · <%= m.distanceMinutes %> min</span>
    </span>
    <span class="scan-qr-btn" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="34" height="34">
        <rect x="4" y="4" width="34" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="6"/>
        <rect x="14" y="14" width="14" height="14" fill="currentColor"/>
        <rect x="62" y="4" width="34" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="6"/>
        <rect x="72" y="14" width="14" height="14" fill="currentColor"/>
        <rect x="4" y="62" width="34" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="6"/>
        <rect x="14" y="72" width="14" height="14" fill="currentColor"/>
        <rect x="48" y="48" width="9" height="9" rx="1" fill="currentColor"/>
        <rect x="62" y="48" width="9" height="9" rx="1" fill="currentColor"/>
        <rect x="76" y="48" width="9" height="9" rx="1" fill="currentColor"/>
        <rect x="48" y="62" width="9" height="9" rx="1" fill="currentColor"/>
        <rect x="62" y="76" width="9" height="9" rx="1" fill="currentColor"/>
        <rect x="76" y="62" width="9" height="9" rx="1" fill="currentColor"/>
      </svg>
    </span>
    <p class="form-status" role="status"></p>
  </button>
</form>
<% }); %>
</div>
<%- include('partials/end', { active: 'scan' }) %>
