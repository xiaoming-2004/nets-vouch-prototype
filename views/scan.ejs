<%- include('partials/start', { title: 'Scan to Pay' }) %>
<header class="page-heading"><h1>Scan to Pay</h1><p>Point your camera at a participating merchant QR.</p></header>
<% if (error) { %><p class="error" role="alert">That QR wasn't recognised. Try a participating merchant.</p><% } %>
<form method="POST" action="/scan" class="scan-launch" data-scan>
<input type="hidden" name="merchantId" value="<%= merchantId %>">
<button class="camera-card" type="submit" aria-label="Scan merchant QR">
<span class="camera-view" aria-hidden="true"><i></i><svg class="qr-icon" viewBox="0 0 100 100" aria-hidden="true"><rect x="4" y="4" width="34" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="5"/><rect x="14" y="14" width="14" height="14" fill="currentColor"/><rect x="62" y="4" width="34" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="5"/><rect x="72" y="14" width="14" height="14" fill="currentColor"/><rect x="4" y="62" width="34" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="5"/><rect x="14" y="72" width="14" height="14" fill="currentColor"/><rect x="48" y="4" width="9" height="9" rx="1" fill="currentColor"/><rect x="4" y="48" width="9" height="9" rx="1" fill="currentColor"/><rect x="48" y="48" width="9" height="9" rx="1" fill="currentColor"/><rect x="62" y="48" width="9" height="9" rx="1" fill="currentColor"/><rect x="76" y="48" width="9" height="9" rx="1" fill="currentColor"/><rect x="90" y="48" width="9" height="9" rx="1" fill="currentColor"/><rect x="48" y="62" width="9" height="9" rx="1" fill="currentColor"/><rect x="76" y="62" width="9" height="9" rx="1" fill="currentColor"/><rect x="48" y="76" width="9" height="9" rx="1" fill="currentColor"/><rect x="62" y="76" width="9" height="9" rx="1" fill="currentColor"/><rect x="90" y="76" width="9" height="9" rx="1" fill="currentColor"/><rect x="76" y="90" width="9" height="9" rx="1" fill="currentColor"/></svg></span>
<strong>Scan Merchant QR</strong><small>Align the merchant code inside the frame</small>
</button><p class="form-status" role="status"></p>
</form>
<%- include('partials/end', { active: 'scan' }) %>
