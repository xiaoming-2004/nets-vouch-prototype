<section class="card empty reveal">
<div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 52 52" fill="none"><circle cx="22" cy="22" r="14" stroke-width="2.5" stroke-linecap="round"/><path d="m32 32 10 10" stroke-width="2.5" stroke-linecap="round"/><path d="M18 22h8M22 18v8" stroke-width="2" stroke-linecap="round"/></svg></div>
<% if (noCloserMatch) { %>
<h2>No closer matches available</h2>
<% if (locationNotice) { %><p>Using demo location</p><% } %>
<p>No closer matches available in your current nearby results.</p>
<form method="POST" action="/recommendation/try-again"><button class="button" type="submit">Try another match</button></form>
<a class="text-button" href="/scan">Scan a merchant directly</a>
<% } else if (typeof researchUnavailable !== 'undefined' && researchUnavailable) { %>
<h2>We couldn't check <%= dietaryLabel.toLowerCase() %> options right now.</h2>
<% if (locationNotice) { %><p>Using demo location</p><% } %>
<p>Dietary suitability needs live menu research, which is unavailable at the moment. Please try again shortly.</p>
<% } else if (typeof noVerifiedDietary !== 'undefined' && noVerifiedDietary) { %>
<h2>No verified <%= dietaryLabel.toLowerCase() %> matches found nearby.</h2>
<% if (locationNotice) { %><p>Using demo location</p><% } %>
<p>We only recommend places where <%= dietaryLabel.toLowerCase() %> suitability is backed by real evidence, and none nearby could be verified right now.</p>
<% } else { %>
<h2>No spots nearby right now</h2>
<% if (locationNotice) { %><p>Using demo location</p><% } %>
<p>No participating merchants match your current filters. Try adjusting below.</p>
<% } %>
<% if (profile) { %>
<div class="refine-chips refine-chips--center"><span class="refine-chip"><%= profile.dietaryPreference === 'none' ? 'Any diet' : profile.dietaryPreference %></span><span class="refine-chip">≤ $<%= profile.budget %></span><span class="refine-chip"><%= profile.maxDistanceMinutes %> min</span></div>
<details class="refine-prefs refine-prefs--flat">
<summary class="refine-summary refine-summary--link">Adjust filters</summary>
<div class="refine-sheet">
<form method="POST" action="/profile" class="form-stack">
<label class="field">Craving<input name="craving" type="text" placeholder="e.g. chicken rice, something light…" maxlength="100" autocomplete="off" value="<%= profile.craving || '' %>"></label>
<label class="field">Mood today<select name="moodCuisine"><% moodCuisineOptions.forEach(function(opt) { %><option value="<%= opt.value %>" <%= opt.value === (profile.moodCuisine || 'any') ? 'selected' : '' %>><%= opt.label %></option><% }); %></select></label>
<label class="field">Dietary<select name="dietaryPreference"><% dietaryPreferenceOptions.forEach(function(opt) { %><option value="<%= opt.value %>" <%= opt.value === profile.dietaryPreference ? 'selected' : '' %>><%= opt.label %></option><% }); %></select></label>
<label class="field">Budget (max $)<input name="budget" type="number" min="1" max="100" step="1" value="<%= profile.budget %>"></label>
<label class="field">Walking distance (max min)<input name="maxDistanceMinutes" type="number" min="1" max="60" step="1" value="<%= profile.maxDistanceMinutes %>"></label>
<input type="hidden" name="notifications" value="<%= profile.notifications ? 'on' : '' %>">
<button class="button" type="submit">Apply &amp; search again</button>
</form>
</div>
</details>
<% } %>
<form method="POST" action="/recommendation/widen-distance"><button class="text-button" type="submit">Widen distance by 5 minutes</button></form>
</section>
