<!DOCTYPE html>
<html lang="en">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"><title>Claim Vouch | NETS Vouch AI</title><link rel="stylesheet" href="/css/style.css"></head>
  <body><main class="prototype-stage"><section class="phone-shell">
    <div class="status-bar" aria-hidden="true"><span>9:41</span><span class="status-bar__island"></span><span class="status-bar__signals">● ◢ ▰</span></div>
    <header class="app-bar"><div class="wordmark"><span class="wordmark__nets">NETS</span><span class="wordmark__vouch">Vouch</span></div><span class="prototype-label">Prototype</span></header>
    <div class="phone-viewport"><div class="screen screen--claim">
      <header class="recommendation-heading"><a class="icon-button" href="/scan">←</a><div><p class="eyebrow">Campaign verified</p><h1><%= availability.title %></h1></div></header>
      <div class="claim-verified"><span aria-hidden="true"><%= availability.available ? '✓' : '!' %></span><div><p class="eyebrow">Verified merchant</p><h2><%= merchant.name %></h2><p><%= merchant.outlet %></p></div></div>
      <article class="claim-card"><p class="eyebrow">Promotional Vouch</p><h2>$<%= campaign.rewardAmount.toFixed(2) %> cashback</h2><p><%= recommendation.itemName %> · estimated $<%= recommendation.price.toFixed(2) %></p><dl><div><dt>Campaign window</dt><dd><%= campaign.startTime %>–<%= campaign.endTime %></dd></div><div><dt>Payment requirement</dt><dd>Eligible NETS payment of at least $1.00</dd></div><div><dt>Claim period</dt><dd><%= claimValidityMinutes %> minutes</dd></div></dl></article>
      <p class="verification-note">The QR identifies this campaign. The following simulated NETS payment verifies reward eligibility.</p>
      <div class="screen-actions screen-actions--bottom">
        <% if (activeClaim && activeClaim.status === 'CLAIMED') { %>
          <a class="button button--full" href="/payment">Continue to payment</a>
        <% } else { %>
          <form method="POST" action="/claim"><button class="button button--full" type="submit" <%= availability.available ? '' : 'disabled' %>>Redeem Vouch</button></form>
        <% } %>
        <a class="back-home-link" href="/home">Back to Home</a>
      </div>
    </div></div><div class="home-indicator" aria-hidden="true"></div>
  </section></main><script src="/js/script.js"></script></body>
</html>
