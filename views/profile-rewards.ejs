<%- include('partials/start', { title: 'Your Rewards' }) %>
<a class="back" href="/profile">← Profile</a><h1>Your Rewards</h1><p>Each Vouch Credit is only usable at that merchant.</p>
<% if (!rewardCredits.length) { %><section class="card state-card"><div class="state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div><h2>No Vouch Credits yet</h2><p>Your merchant Vouch Credits will appear here.</p></section><% } else { %><div class="reward-passes rewards-page"><% rewardCredits.forEach(function(credit) { %><article class="reward-pass"><span class="merchant-badge"><%= credit.merchantName.charAt(0) %></span><div><strong><%= credit.merchantName %></strong><small>Use on your next NETS payment at <%= credit.merchantName %></small></div><b>$<%= credit.amount.toFixed(2) %><small>Vouch Credit</small></b></article><% }); %></div><% } %>
<%- include('partials/end', { active: 'profile' }) %>
