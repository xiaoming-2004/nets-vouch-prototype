<%- include('partials/start', { title: 'Profile' }) %>
<section class="profile-hero"><span class="profile-avatar">J</span><h1><%= user.fullName || user.name %></h1><p>NETS Vouch Member</p><div class="preference-chips"><span><%= dietaryLabel %></span><span>≤ $<%= profile.budget.toFixed(0) %></span><span><%= profile.maxDistanceMinutes %> min</span></div><a href="/profile/preferences">Edit preferences →</a></section>
<nav class="profile-menu" aria-label="Profile menu"><a href="/profile/rewards"><span><strong>Your Rewards</strong><small><%= rewardCredits.length ? rewardCredits.length + (rewardCredits.length === 1 ? ' merchant credit' : ' merchant credits') : 'No merchant credits yet' %></small></span><b>›</b></a><a href="/profile/vouches"><span><strong>My Vouches</strong><small>Payment-Verified Vouches</small></span><b>›</b></a><a href="/profile/activity"><span><strong>NETS Activity</strong><small>Recent NETS payments</small></span><b>›</b></a><a href="/profile/preferences"><span><strong>Preferences</strong><small><%= dietaryLabel %> · $<%= profile.budget.toFixed(0) %> · <%= profile.maxDistanceMinutes %> min</small></span><b>›</b></a><a href="/profile/preferences"><span><strong>Notifications</strong><small>Payment and reward updates</small></span><em><%= profile.notifications ? 'On' : 'Off' %></em></a></nav>
<%- include('partials/end', { active: 'profile' }) %>
