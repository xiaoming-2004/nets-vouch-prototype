<%- include('partials/start', { title: 'Profile' }) %>
<p class="eyebrow">Your space</p><h1><%= user.name %></h1>
<section class="balance-card"><span>Vouch Cashback</span><strong>$<%= cashbackBalance.toFixed(2) %></strong><small>Available for your next payment</small></section>
<nav class="tabs" aria-label="Profile sections"><a href="/profile" <%- tab === 'settings' ? 'aria-current="page"' : '' %>>Preferences</a><a href="/profile?tab=vouches" <%- tab === 'vouches' ? 'aria-current="page"' : '' %>>My Vouches</a><a href="/profile?tab=transactions" <%- tab === 'transactions' ? 'aria-current="page"' : '' %>>NETS Activity</a></nav>
<% if (tab === 'settings') { %>
<% if (settingsError) { %><p class="error">Please choose valid settings.</p><% } %>
<form method="POST" action="/profile" class="card form-stack">
<label class="field">Dietary preference<select name="dietaryPreference"><% dietaryPreferenceOptions.forEach(function(option) { %><option value="<%= option.value %>" <%= profile.dietaryPreference === option.value ? 'selected' : '' %>><%= option.label %></option><% }); %></select></label>
<label class="field">Budget ($)<input type="number" name="budget" value="<%= profile.budget.toFixed(2) %>" min="1" max="100" step=".01" required></label>
<label class="field">Maximum walk (minutes)<input type="number" name="maxDistanceMinutes" value="<%= profile.maxDistanceMinutes %>" min="1" max="60" required></label>
<label class="cashback-toggle"><span>Notifications<small>In-app readiness updates</small></span><input type="checkbox" name="notifications" <%= profile.notifications ? 'checked' : '' %>></label>
<button class="button" type="submit">Save preferences</button></form>
<% } else if (tab === 'transactions') { %>
<h2>NETS Activity</h2><% if (!transactions.length) { %><p class="card">Your payments will appear here.</p><% } %>
<div class="list"><% transactions.forEach(function(transaction) { %><a class="activity-row" href="/transactions/<%= transaction.id %>"><span class="monogram"><%= transaction.merchantName.charAt(0) %></span><span><strong><%= transaction.merchantName %></strong><small><%= transaction.date %> · <%= transaction.time %></small></span><b>$<%= transaction.netsPaid.toFixed(2) %></b></a><% }); %></div>
<% } else { %>
<h2>Payment-Verified Vouches</h2><% if (!paymentVerifiedVouches.length) { %><p class="card">Your first Vouch starts with a NETS payment.</p><% } %>
<% paymentVerifiedVouches.forEach(function(vouch) { %><article class="card"><span class="eyebrow">Payment-Verified ✓</span><h3><%= vouch.merchantName %></h3><p><%= vouch.date %> · <%= vouch.user %></p><small>Transaction <%= vouch.transactionId %> · Simulated verification</small></article><% }); %>
<h2>Cashback earned</h2><% if (!promotionalRedemptions.length) { %><p>No rewards earned yet.</p><% } %>
<% promotionalRedemptions.forEach(function(redemption) { %><article class="card"><h3><%= redemption.merchantName %></h3><p class="reward">+$<%= redemption.rewardAmount.toFixed(2) %></p><small><%= redemption.date %></small></article><% }); %>
<% } %>
<details class="demo-controls"><summary>Open House controls</summary><a class="text-button" href="/merchant?tab=orders">Merchant view</a><form method="POST" action="/reset-demo" data-confirm-reset><button class="text-button" type="submit">Reset Demo</button></form></details>
<%- include('partials/end', { active: 'profile' }) %>
