<%- include('partials/start', { title: 'Profile' }) %>
<section class="profile-hero"><span class="profile-avatar"><%= user.name.charAt(0).toUpperCase() %></span><h1><%= user.fullName || user.name %></h1><div class="preference-chips"><span><%= dietaryLabel %></span><% if (profile.craving) { %><span>Craving: <%= profile.craving %></span><% } else if (profile.moodCuisine && profile.moodCuisine !== 'any') { %><span>Mood: <%= moodCuisineLabel %></span><% } %><span>≤ $<%= profile.budget.toFixed(0) %></span><span><%= profile.maxDistanceMinutes %> min</span></div><a href="/profile/preferences">Edit preferences →</a></section>
<section class="profile-section"><h2>Your Vouch Credits</h2>
<% if (!rewardCredits.length) { %><p class="empty-line">Your merchant Vouch Credits will appear here.</p><% } else { %>
<div class="reward-passes"><% rewardCredits.slice(0, 3).forEach(function(credit) { %><article class="reward-pass"><span class="merchant-badge"><%= credit.merchantName.charAt(0) %></span><div><strong><%= credit.merchantName %></strong><small>Use only at <%= credit.merchantName %></small></div><b>$<%= credit.amount.toFixed(2) %></b></article><% }); %></div>
<a class="text-button" href="/profile/rewards">View all →</a>
<% } %>
</section>
<nav class="profile-menu" aria-label="Profile menu"><a href="/profile/vouches"><span><strong>My Vouches</strong><small>Payment-Verified Vouches</small></span><b>›</b></a><a href="/profile/activity"><span><strong>NETS Activity</strong><small>Recent NETS payments</small></span><b>›</b></a><a href="/profile/preferences"><span><strong>Preferences</strong><small><%= dietaryLabel %> · $<%= profile.budget.toFixed(0) %> · <%= profile.maxDistanceMinutes %> min</small></span><b>›</b></a><a href="/profile/preferences"><span><strong>Notifications</strong><small>Payment and reward updates</small></span><em><%= profile.notifications ? 'On' : 'Off' %></em></a></nav>
<%- include('partials/end', { active: 'profile' }) %>
