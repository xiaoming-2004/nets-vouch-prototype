<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Choose personalisation and privacy settings for the NETS Vouch AI prototype">
    <meta name="theme-color" content="#083b66">
    <title>Personalisation | NETS Vouch AI</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main class="prototype-stage">
      <section class="phone-shell" aria-label="NETS Vouch AI prototype">
        <div class="status-bar" aria-hidden="true">
          <span>9:41</span>
          <span class="status-bar__island"></span>
          <span class="status-bar__signals">● ◢ ▰</span>
        </div>

        <header class="app-bar">
          <div class="wordmark" aria-label="NETS Vouch">
            <span class="wordmark__nets">NETS</span>
            <span class="wordmark__vouch">Vouch</span>
          </div>
          <span class="prototype-label">Prototype</span>
        </header>

        <div class="phone-viewport">
          <form class="screen screen--personalisation" method="POST" action="/personalisation">
            <p class="eyebrow">You stay in control</p>
            <h1>Set up Vouch AI</h1>
            <p class="user-context">Current demo user <strong><%= user.name %></strong></p>
            <p class="screen-lede">
              Choose what NETS may use. Turn transaction analysis off anytime and continue in Basic Mode.
            </p>

            <div class="privacy-list">
              <label class="privacy-row" for="recommendations">
                <span class="privacy-row__icon" aria-hidden="true">✦</span>
                <span class="privacy-row__copy">
                  <strong>Personalised recommendations</strong>
                  <small>Use the preferences you choose.</small>
                </span>
                <input
                  class="privacy-checkbox"
                  type="checkbox"
                  id="recommendations"
                  name="recommendations"
                  <%= personalisation.recommendations ? 'checked' : '' %>
                >
                <span class="switch" aria-hidden="true"><i></i></span>
              </label>

              <label class="privacy-row" for="transactionAnalysis">
                <span class="privacy-row__icon" aria-hidden="true">✓</span>
                <span class="privacy-row__copy">
                  <strong>NETS activity patterns</strong>
                  <small>Optional patterns only — never public.</small>
                </span>
                <input
                  class="privacy-checkbox"
                  type="checkbox"
                  id="transactionAnalysis"
                  name="transactionAnalysis"
                  <%= personalisation.transactionAnalysis ? 'checked' : '' %>
                >
                <span class="switch" aria-hidden="true"><i></i></span>
              </label>

              <label class="privacy-row" for="location">
                <span class="privacy-row__icon" aria-hidden="true">⌖</span>
                <span class="privacy-row__copy">
                  <strong>Location while using</strong>
                  <small>Find participating options nearby.</small>
                </span>
                <input
                  class="privacy-checkbox"
                  type="checkbox"
                  id="location"
                  name="location"
                  <%= personalisation.location ? 'checked' : '' %>
                >
                <span class="switch" aria-hidden="true"><i></i></span>
              </label>

              <label class="privacy-row" for="notifications">
                <span class="privacy-row__icon" aria-hidden="true">●</span>
                <span class="privacy-row__copy">
                  <strong>Helpful notifications</strong>
                  <small>One timely suggestion, not a promo feed.</small>
                </span>
                <input
                  class="privacy-checkbox"
                  type="checkbox"
                  id="notifications"
                  name="notifications"
                  <%= personalisation.notifications ? 'checked' : '' %>
                >
                <span class="switch" aria-hidden="true"><i></i></span>
              </label>
            </div>

            <div
              class="mode-note <%= personalisation.transactionAnalysis ? 'mode-note--personalised' : 'mode-note--basic' %>"
              id="modeNote"
              aria-live="polite"
            >
              <% if (personalisation.transactionAnalysis) { %>
                <strong id="modeTitle">Personalised Mode</strong>
                <span id="modeDescription">Optional NETS activity patterns are enabled together with the preferences you choose.</span>
              <% } else { %>
                <strong id="modeTitle">Basic Mode</strong>
                <span id="modeDescription">Recommendations can use your selected preferences, location and time. No transaction history is required.</span>
              <% } %>
            </div>

            <div class="screen-actions screen-actions--bottom">
              <button class="button button--full" type="submit">Save and continue</button>
              <p class="action-helper">Fictional settings for this proposed prototype</p>
            </div>
          </form>
        </div>

        <div class="home-indicator" aria-hidden="true"></div>
      </section>
    </main>

    <script src="/js/script.js"></script>
  </body>
</html>
