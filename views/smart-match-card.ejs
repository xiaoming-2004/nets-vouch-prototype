<article class="smart-match-card smart-match-reveal" data-recommendation-id="<%= recommendation.id %>">
  <div class="smart-match-card__visual" aria-hidden="true">
    <span class="smart-match-card__dish"><%= recommendation.dietary.includes('vegan') ? '🥗' : recommendation.category === 'noodles' ? '🍜' : '🍚' %></span>
  </div>
  <div class="smart-match-card__body">
    <p class="smart-match-card__merchant">Your Smart Match</p>
    <p class="smart-match-card__place"><%= recommendation.merchantName %></p>
    <h2><%= recommendation.itemName %></h2>
    <p class="smart-match-card__facts">
      <% if (recommendation.price !== null) { %><span>$<%= recommendation.price.toFixed(2) %></span><% } %>
      <% if (recommendation.dietary.length > 0) { %><span><%= recommendation.dietary[recommendation.dietary.length - 1].charAt(0).toUpperCase() + recommendation.dietary[recommendation.dietary.length - 1].slice(1) %></span><% } %>
      <span><%= recommendation.distanceMinutes %> min walk</span>
    </p>
    <% if (campaign) { %>
      <div class="smart-match-reward"><span>NETS Vouch</span><strong>$<%= campaign.rewardAmount.toFixed(2) %> cashback</strong></div>
    <% } %>
    <div class="smart-match-why">
      <strong>Why this match?</strong>
      <ul><% matchReasons.forEach(function(reason) { %><li><%= reason %></li><% }); %></ul>
    </div>
    <% if (campaign) { %>
      <form method="POST" action="/recommendation/accept">
        <button class="button button--full smart-match-view" type="submit">Accept</button>
      </form>
    <% } %>
    <a class="smart-match-reject" href="/recommendation/reject">Not for me</a>
  </div>
</article>
