<% var display = locals.resultDisplay || {}; %>
<%
// "Why this match" is assembled server-side by buildMatchExplanation from the validated ranking
// reason and this recommendation's own facts - no extra AI or provider call. The collapsed card shows only
// the decision facts; reasons and disclosures live in the "Why this match?" disclosure. Google route facts
// (attribution and walking warning) are NEVER inside the disclosure: they are visible whenever shown.
var whyText = locals.matchExplanation || '';
var isSample = recommendation.isSampleData === true;
var item = recommendation.recommendedMenuItem || null;
var typicalDiffers = item && Number.isFinite(recommendation.price) && Math.abs(recommendation.price - Number(item.price)) >= 0.005;
%>
<article class="match-card reveal" data-merchant-id="<%= recommendation.id %>">
<div class="match-copy">
<div class="result-head">
<div class="result-photo<%= display.photo ? '' : ' is-empty' %>">
<% if (display.photo) { %><img src="<%= display.photo.src %>" alt="<%= recommendation.merchantName %> (photo posted by the business)" width="72" height="72" decoding="async" onerror="this.parentNode.classList.add('is-empty');this.remove();"><% } %>
<span class="result-photo-fallback" aria-hidden="true"><%= recommendation.merchantName.charAt(0) %></span>
</div>
<div class="result-info">
<h3 title="<%= recommendation.merchantName %>"><%= recommendationAccepted ? 'Heading to ' + recommendation.merchantName + '?' : recommendation.merchantName %></h3>
<% if (isSample) { %><p class="sample-label"><%= recommendation.source === 'mysql' ? 'Fictional sample merchant' : 'Demo merchant' %></p><% } %>
<%
var metaLead = recommendation.parentVenueName || recommendation.categoryLabel || recommendation.cuisine || recommendation.category || '';
%><p class="result-meta"><% if (metaLead) { %><span class="result-lead"><%= metaLead %></span><% } %><% if (!recommendation.travel && !isSample && (recommendation.distanceLabel || Number.isFinite(recommendation.distanceMinutes))) { %><span class="result-distance"><%= recommendation.distanceLabel ? recommendation.distanceLabel + ((recommendation.source === 'mysql' || isSample) && !/demo origin|RP demo/i.test(recommendation.distanceLabel) ? ' · RP demo estimate' : '') : recommendation.distanceMinutes + ' min away' %></span><% } %></p>
<p class="result-tags"><% if (display.demoVouches) { %><span class="result-vouches" data-demo-sample="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m7.5 12.3 3 3 6-6.3"/></svg><%= display.demoVouches %> Vouches</span><% } %><% if (display.dietary) { %><span class="diet-tag diet-tag--<%= display.dietary.tone %>"><%= display.dietary.label %></span><% } %><% if (dietaryTagLabel && dietaryTagLabel !== 'Halal') { %><span class="match-diet"><%= dietaryTagLabel %></span><% } %></p>
</div>
</div>
<% if (item) { %><p class="result-facts"><%- include('partials/recommended-item', { item: item }) %></p><% } %>
<% if (recommendation.travel) { %><%- include('partials/google-walking', { travel: recommendation.travel }) %><% } %>
<% if (isSample && !recommendation.travel && (recommendation.distanceLabel || Number.isFinite(recommendation.distanceMinutes))) { %><div class="demo-distance"><svg class="demo-distance__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span class="demo-distance__text"><strong>RP demo distance</strong><span><%= recommendation.distanceLabel ? recommendation.distanceLabel + (/demo origin|RP demo/i.test(recommendation.distanceLabel) ? '' : ' · RP demo estimate') : recommendation.distanceMinutes + ' min away · RP demo estimate' %></span></span></div><% } %>
<% if (recommendation.source === 'mysql' && !item) { %>
<p class="result-facts">Typical price: <%= Number.isFinite(recommendation.price) ? '$' + recommendation.price.toFixed(2) : 'unavailable' %></p>
<% } else if (typicalDiffers) { %>
<p class="result-facts result-facts--quiet">Typical merchant price $<%= recommendation.price.toFixed(2) %></p>
<% } %>
<% if (recommendation.itemName) { %>
<p class="result-facts"><span class="result-dish"><span class="result-dish-name">Try: <%= recommendation.itemName %></span><% if (recommendation.price !== null) { %><span class="result-dish-price">$<%= recommendation.price.toFixed(2) %></span><% } %></span></p>
<% } %>
<% if (recommendation.usualActivity) {
var usual = recommendation.usualActivity;
var activityCopy = usual.status === 'available'
  ? 'Usually ' + usual.comparison + ' at this time based on fictional sample history.'
  : usual.status === 'insufficient-data'
    ? 'Not enough fictional sample history for this time.'
    : 'Usual activity unavailable — fictional sample history only.';
%><p class="result-activity" data-activity-state="<%= usual.status %>"><%= activityCopy %></p><% } %>
<% if (recommendation.coordinates && recommendation.source !== 'mysql') { %>
<div class="match-map-wrap">
<div class="match-map" data-lat="<%= recommendation.coordinates.latitude %>" data-lng="<%= recommendation.coordinates.longitude %>" data-name="<%= recommendation.merchantName %>" data-address="<%= recommendation.address || '' %>"></div>
<% if (display.walking) { %><a class="match-map-open" href="<%= display.walking.mapsUrl %>" target="_blank" rel="noopener noreferrer"><span class="match-map-hint">Open in Google Maps<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></span><span class="visually-hidden"> - walking directions to <%= recommendation.merchantName %></span></a><% } %>
</div>
<% } %>
<% if (campaign && dailyRewardEarned) { %><p class="reward earned">Today's <%= rewardCreditText(campaign.rewardAmount, campaign.rewardLabel) %> earned ✓<small>You can still use your available <%= recommendation.merchantName %> Vouch Credit.</small></p><% } else if (campaign) { %><p class="reward"><%= rewardCreditText(campaign.rewardAmount, campaign.rewardLabel) %> <small>Once daily · Spend $<%= campaign.minimumEligibleSpend.toFixed(2) %>+ · Simulated payment · Credit usable only at <%= recommendation.merchantName %>.</small></p><% } else { %><p class="reward reward--ended" role="status">This offer has ended. Choose another spot.</p><% } %>
<% if (campaign && !recommendationAccepted) { %><form method="POST" action="/recommendation/accept" data-single-submit><input type="hidden" name="merchantId" value="<%= recommendation.id %>"><button class="button" type="submit">Choose this</button></form><% } %>
<% if (campaign && recommendationAccepted) { %><a class="button" href="/scan">Scan when you arrive</a><% } %>
<div class="result-secondary">
<% if (recommendation.feedbackToken) { %>
<details class="feedback sheet-host" id="feedback">
<summary class="sheet-trigger"><%= recommendationAccepted ? 'Changed your mind?' : 'Not for me' %></summary>
<div class="result-sheet">
<span class="result-sheet-backdrop" data-sheet-backdrop></span>
<div class="result-sheet-panel feedback-sheet" role="group" aria-label="What didn't fit about this match">
<div class="result-sheet-head"><h3>What didn't fit?</h3><button class="sheet-close" type="button" data-sheet-close>Close</button></div>
<form method="POST" action="/recommendation/reject" data-feedback>
<input type="hidden" name="merchantId" value="<%= recommendation.id %>">
<input type="hidden" name="feedbackToken" value="<%= recommendation.feedbackToken || '' %>">
<% rejectionReasons.forEach(function(reason) { %><button type="submit" name="reason" value="<%= reason.id %>"><%= reason.label %><span aria-hidden="true">→</span></button><% }); %>
<p class="feedback-status" data-feedback-status role="status"></p>
</form>
</div></div>
</details>
<% } %>
<% if (profile) { %>
<details class="refine-prefs sheet-host" id="refine">
<summary class="sheet-trigger sheet-trigger--quiet"><span class="refine-edit">Craving and mood</span></summary>
<div class="result-sheet">
<span class="result-sheet-backdrop" data-sheet-backdrop></span>
<div class="result-sheet-panel refine-sheet" role="group" aria-label="Edit craving and mood">
<div class="result-sheet-head"><h3>Craving and mood</h3><button class="sheet-close" type="button" data-sheet-close>Close</button></div>
<p class="refine-chips"><span class="refine-chip"><%= dietaryLabel %></span><% if (profile.moodCuisine && profile.moodCuisine !== 'any') { %><span class="refine-chip">Mood: <%= moodCuisineLabel %></span><% } %><span class="refine-chip">≤ $<%= profile.budget %></span><span class="refine-chip"><%= profile.maxDistanceMinutes %> min</span></p>
<form method="POST" action="/profile" class="form-stack">
<label class="field">Craving<input name="craving" type="text" placeholder="e.g. chicken rice, something light…" maxlength="100" autocomplete="off" value="<%= profile.craving || '' %>"></label>
<p class="field-hint">Dietary: <strong><%= dietaryLabel %></strong> · <a href="/profile/dietary">Change in Profile</a></p>
<div class="field"><span class="field-label">Mood today</span><div class="mood-grid"><% moodCuisineOptions.forEach(function(opt) { %><label class="mood-chip"><input type="radio" name="moodCuisine" value="<%= opt.value %>" <%= opt.value === (profile.moodCuisine || 'any') ? 'checked' : '' %>><span><%= opt.label %></span></label><% }); %></div></div>
<label class="field">Budget (max $)<input name="budget" type="number" min="1" max="100" step="1" value="<%= profile.budget %>"></label>
<label class="field">Walking distance (max min)<input name="maxDistanceMinutes" type="number" min="1" max="60" step="1" value="<%= profile.maxDistanceMinutes %>"></label>
<input type="hidden" name="notifications" value="<%= profile.notifications ? 'on' : '' %>">
<button class="button" type="submit">Apply &amp; find new match</button>
</form>
</div></div>
</details>
<% } %>
</div>
<details class="why-match">
<summary class="why-match__summary">Why this match?</summary>
<div class="why-match__body">
<% if (Array.isArray(recommendation.matchReasons) && recommendation.matchReasons.length) { %>
<ul class="result-match-reasons" aria-label="Why this matches"><% recommendation.matchReasons.forEach(function(reason) { %><li><%= reason %></li><% }); %></ul>
<% } %>
<% if (whyText) { %><p class="result-why-text"><%= whyText %></p><% } %>
<% if (display.dietary) { %><p class="result-diet-note"><%= display.dietary.note %></p><% } %>
<% if (isSample && recommendation.source === 'mysql') { %><p class="result-note-line">Sample catalogue data: fictional merchants, menus and prices; dietary claims are unverified.</p><% } %>
<p class="result-note-line"><%= recommendation.travel ? 'Walking times come from Google Maps for the starting point you chose. The destination is a fictional sample merchant coordinate, not a Google place.' : 'Distances are estimates from the RP demo origin, not real walking times.' %></p>
<% if (locationNotice) { %><p class="result-note-line">Using demo location</p><% } %>
<% if (display.photo && display.photo.attributions && display.photo.attributions.length) { %><p class="result-photo-credit">Photo: <% display.photo.attributions.forEach(function(a, i) { %><%= i ? ', ' : '' %><% if (a.uri) { %><a href="<%= a.uri %>" target="_blank" rel="noopener noreferrer"><%= a.name %></a><% } else { %><%= a.name %><% } %><% }); %></p><% } %>
</div>
</details>
</div></article>
