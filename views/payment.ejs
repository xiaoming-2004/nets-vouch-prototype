<%- include('partials/start', { title: 'Scan to Pay' }) %>
<a class="back" href="/home">← Home</a><p class="eyebrow">Merchant found ✓</p><h1>How much are you paying?</h1>
<div class="merchant-heading"><span class="monogram"><%= journey.merchantName.charAt(0) %></span><div><h2><%= journey.merchantName %></h2><p><%= scan ? journey.outlet : journey.itemName %></p></div></div>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<form method="POST" action="/scan/payment" data-payment data-balance="<%= merchantCredit %>" data-amount="">
<input type="hidden" name="journeyId" value="<%= journey.id %>">
<section class="card">
<label class="field">Purchase amount
<span class="amount-input"><span>$</span><input name="amount" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" maxlength="7" placeholder="0.00" required aria-label="Purchase amount in dollars" value="<%= journey.enteredAmount || '' %>"></span></label>
<label class="cashback-toggle"><span><strong>Use <%= journey.merchantName %> Vouch Credit</strong><small>$<%= merchantCredit.toFixed(2) %> available</small></span><input type="checkbox" name="useCashback" <%= merchantCredit > 0 ? '' : 'disabled' %>></label>
<div class="line"><span>Vouch Credit used</span><strong data-cashback-used>−$0.00</strong></div>
<div class="total"><span>Pay with NETS</span><strong data-nets-total>$0.00</strong></div>
<% if (campaign) { %><p class="reward-note">Earn $<%= campaign.rewardAmount.toFixed(2) %> <%= journey.merchantName %> Vouch Credit after payment.</p><small>At least $1 must be paid with NETS. Subject to campaign availability.</small><% } %>
</section>
<button class="button" type="submit" data-pay-button>Pay</button>
<p class="form-status" role="status"></p>
</form>
<form method="POST" action="/scan/cancel"><input type="hidden" name="journeyId" value="<%= journey.id %>"><button class="text-button" type="submit">Scan another merchant</button></form>
<%- include('partials/end', { active: 'scan' }) %>
