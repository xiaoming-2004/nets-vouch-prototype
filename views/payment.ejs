<%- include('partials/start', { title: 'Pay with NETS' }) %>
<div class="pay-head"><a class="back-icon" href="/home" aria-label="Back to Home">←</a><h1 class="pay-title">Pay with NETS</h1></div>
<p class="eyebrow scan-found">✓ Merchant found</p>
<div class="pay-merchant"><span class="monogram pay-monogram"><%= journey.merchantName.charAt(0) %></span><h2><%= journey.merchantName %></h2><p><%= journey.outlet %></p></div>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<form method="POST" action="/scan/payment" data-payment data-balance="<%= merchantCredit %>" data-amount="">
<input type="hidden" name="journeyId" value="<%= journey.id %>">
<label class="pay-amount-block"><span class="eyebrow">You're paying</span><span class="amount-input"><span>$</span><input name="amount" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" maxlength="7" placeholder="0.00" required aria-label="Purchase amount in dollars" value="<%= journey.enteredAmount || '' %>"></span></label>
<% if (merchantCredit > 0) { %><label class="credit-toggle"><span><strong><%= journey.merchantName %> Vouch Credit</strong><small>$<%= merchantCredit.toFixed(2) %> available · use only at <%= journey.merchantName %></small></span><span class="switch"><input type="checkbox" name="useCashback"><span class="switch-track"></span></span></label><% } %>
<div class="pay-summary">
<div class="line"><span>Purchase amount</span><strong data-purchase-amount>$0.00</strong></div>
<% if (merchantCredit > 0) { %><div class="line"><span><%= journey.merchantName %> Vouch Credit</span><strong data-cashback-used>Not applied</strong></div><% } %>
<div class="total"><span>Pay with NETS</span><strong data-nets-total>$0.00</strong></div>
</div>
<% if (campaign && dailyRewardEarned) { %><p class="pay-hint earned">Today's <%= journey.merchantName %> reward earned ✓<br>You can still use your available Vouch Credit.</p><% } else if (campaign) { %><p class="pay-hint" data-reward-eligibility data-minimum-spend="<%= campaign.minimumEligibleSpend %>" data-reward-amount="<%= campaign.rewardAmount %>" data-merchant-name="<%= journey.merchantName %>">Earn $<%= campaign.rewardAmount.toFixed(2) %> <%= journey.merchantName %> Vouch Credit. Once daily · Spend $<%= campaign.minimumEligibleSpend.toFixed(2) %>+ and keep at least $1 paid with NETS.</p><% } %>
<button class="button" type="submit" data-pay-button>Pay</button>
<p class="form-status" role="status"></p>
</form>
<form method="POST" action="/scan/cancel"><input type="hidden" name="journeyId" value="<%= journey.id %>"><button class="text-button" type="submit">Scan another merchant</button></form>
<%- include('partials/end', { active: 'scan' }) %>
