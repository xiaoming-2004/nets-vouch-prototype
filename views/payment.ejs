<%- include('partials/start', { title: scan ? 'Scan to Pay' : 'Review order' }) %>
<a class="back" href="/home">← Home</a><p class="eyebrow"><%= scan ? 'Merchant found ✓' : 'Collection order' %></p><h1><%= scan ? 'How much are you paying?' : 'Review your order' %></h1>
<div class="merchant-heading"><span class="monogram"><%= journey.merchantName.charAt(0) %></span><div><h2><%= journey.merchantName %></h2><p><%= scan ? journey.outlet : journey.itemName %></p></div></div>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<form method="POST" action="<%= scan ? '/scan/payment' : '/payment' %>" data-payment data-balance="<%= merchantCredit %>" data-amount="<%= scan ? '' : journey.orderAmount %>">
<input type="hidden" name="journeyId" value="<%= journey.id %>">
<section class="card">
<% if (scan) { %>
<label class="field">Purchase amount
<span class="amount-input"><span>$</span><input name="amount" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" maxlength="7" placeholder="0.00" required aria-label="Purchase amount in dollars" value="<%= journey.enteredAmount || '' %>"></span></label>
<% } else { %><div class="total"><span>Order total</span><strong>$<%= journey.orderAmount.toFixed(2) %></strong></div><p>Collection at <%= journey.outlet %></p><% } %>
<label class="cashback-toggle"><span><strong>Use <%= journey.merchantName %> Vouch Credit</strong><small>$<%= merchantCredit.toFixed(2) %> available</small></span><input type="checkbox" name="useCashback" <%= merchantCredit > 0 ? '' : 'disabled' %>></label>
<div class="line"><span>Vouch Credit used</span><strong data-cashback-used>−$0.00</strong></div>
<div class="total"><span>Pay with NETS</span><strong data-nets-total>$<%= scan ? '0.00' : journey.orderAmount.toFixed(2) %></strong></div>
<% if (campaign) { %><p class="reward-note">Earn $<%= campaign.rewardAmount.toFixed(2) %> <%= journey.merchantName %> Vouch Credit <%= scan ? 'after payment' : 'after collection' %>.</p><small>At least $1 must be paid with NETS. Subject to campaign availability.</small><% } %>
</section>
<button class="button" type="submit" data-pay-button>Pay <%= scan ? '' : '$' + journey.orderAmount.toFixed(2) %></button>
<p class="form-status" role="status"></p>
</form>
<% if (scan) { %><form method="POST" action="/scan/cancel"><input type="hidden" name="journeyId" value="<%= journey.id %>"><button class="text-button" type="submit">Scan another merchant</button></form><% } %>
<%- include('partials/end', { active: scan ? 'scan' : 'home' }) %>
