<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Simulated NETS payment confirmation">
    <meta name="theme-color" content="#082f5b">
    <title>Confirm Payment | NETS Vouch AI</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <main class="prototype-stage">
      <section class="phone-shell" aria-label="NETS Vouch AI prototype">
        <div class="status-bar" aria-hidden="true"><span>9:41</span><span class="status-bar__island"></span><span class="status-bar__signals">● ◢ ▰</span></div>
        <header class="app-bar"><div class="wordmark"><span class="wordmark__nets">NETS</span><span class="wordmark__vouch">Vouch</span></div></header>
        <div class="phone-viewport">
          <div class="screen scan-pay-screen">
            <header class="recommendation-heading">
              <a class="icon-button" href="/home" aria-label="Cancel payment">×</a>
              <div><p class="eyebrow"><%= order ? 'Order review' : 'QR verified' %></p><h1><%= order ? 'Review your order' : 'Confirm payment' %></h1></div>
            </header>

            <% if (order) { %>
              <ol class="scan-pay-steps" aria-label="Order steps"><li class="is-active"><span>1</span>Review</li><li><span>2</span>Pay</li><li><span>3</span>Collect</li></ol>
            <% } else { %>
              <ol class="scan-pay-steps" aria-label="Scan-to-pay steps"><li class="is-complete"><span>✓</span>Scan</li><li class="is-active"><span>2</span>Pay</li><li><span>3</span>Done</li></ol>
            <% } %>

            <section class="quick-pay-card">
              <div class="quick-pay-card__merchant">
                <span class="merchant-monogram" aria-hidden="true">F</span>
                <div><small><%= order ? 'Collecting from merchant' : 'Paying' %></small><h2><%= merchant.name %></h2><p><%= recommendation.itemName %></p></div>
              </div>
              <div class="quick-pay-card__amount"><span>Total</span><strong>$<%= recommendation.price.toFixed(2) %></strong></div>
              <div class="quick-pay-card__vouch"><span aria-hidden="true">✓</span><div><strong>$<%= campaign.rewardAmount.toFixed(2) %> merchant cashback</strong><small><%= order ? 'Released after eligible NETS payment and collection' : 'After payment verification' %></small></div></div>
              <% if (order) { %><p class="verification-note">Collection from merchant. No delivery.</p><% } %>
            </section>

            <form class="quick-pay-action" method="POST" action="/payment" data-single-submit>
              <button class="button button--full" type="submit" data-submit-text="Processing...">Confirm payment · $<%= recommendation.price.toFixed(2) %></button>
              <p>Pay securely with NETS.</p>
            </form>
          </div>
          <%- include('partials/jia-nav', { active: 'home' }) %>
        </div>
        <div class="home-indicator" aria-hidden="true"></div>
      </section>
    </main>
    <script src="/js/script.js"></script>
  </body>
</html>
