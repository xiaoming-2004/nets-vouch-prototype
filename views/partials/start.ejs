<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#f4f5f7"><title><%= title %> · NETS Vouch AI</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/></head>
<body class="<%= locals.mode === 'merchant' ? 'mode-merchant' : '' %> <%= locals.page ? 'page-' + locals.page : '' %>"><div class="stage">
<div class="device"><span class="device-button device-button--action" aria-hidden="true"></span><span class="device-button device-button--vol-up" aria-hidden="true"></span><span class="device-button device-button--vol-down" aria-hidden="true"></span><span class="device-button device-button--power" aria-hidden="true"></span><span class="device-button device-button--camera" aria-hidden="true"></span>
<div class="device-bezel"><section class="phone">
<div class="status-bar" aria-hidden="true"><span class="status-time" data-status-time>9:41</span><span class="dynamic-island"></span><span class="status-icons"><svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg><svg viewBox="0 0 16 12"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0z"/><path d="M8 5.2a6.7 6.7 0 0 1 4.8 2l-1.3 1.3a4.9 4.9 0 0 0-7 0L3.2 7.2A6.7 6.7 0 0 1 8 5.2z"/><path d="M8 1a10.8 10.8 0 0 1 7.7 3.2l-1.3 1.3a9 9 0 0 0-12.8 0L.3 4.2A10.8 10.8 0 0 1 8 1z"/></svg><svg viewBox="0 0 27 12"><rect x=".5" y=".5" width="23" height="11" rx="3.5" fill="none" stroke="currentColor" stroke-opacity=".4"/><rect x="2" y="2" width="18" height="8" rx="2"/><path d="M25 4v4a2 2 0 0 0 0-4z" fill-opacity=".4"/></svg></span></div>
<header class="app-header"><a class="brand" href="/home"><img class="brand-logo" src="/images/nets-vouch-ai-logo.jpg" alt="NETS Vouch AI" width="1289" height="240"></a><details class="account-menu"><summary class="avatar" aria-label="Switch view"><%= locals.mode === 'merchant' ? 'M' : (locals.demoUser ? locals.demoUser.name.charAt(0).toUpperCase() : 'J') %></summary>
<div class="account-menu-sheet" role="menu"><p class="eyebrow">Switch view</p>
<a role="menuitem" href="/home" <%- locals.mode !== 'merchant' ? 'aria-current="true"' : '' %>><span class="account-menu-icon"><%= locals.demoUser ? locals.demoUser.name.charAt(0).toUpperCase() : 'J' %></span><span><strong><%= locals.demoUser ? locals.demoUser.name : 'Customer' %></strong><small>Customer app</small></span></a>
<a role="menuitem" href="/merchant" <%- locals.mode === 'merchant' ? 'aria-current="true"' : '' %>><span class="account-menu-icon account-menu-icon--merchant">M</span><span><strong>Merchant</strong><small>Merchant dashboard</small></span></a>
<a role="menuitem" class="account-menu-link" href="/profile">View profile</a></div></details></header>
<main class="screen" id="main">
