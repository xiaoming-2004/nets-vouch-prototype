<%- include('partials/start', { title: 'Demo controls' }) %>
<a class="back" href="/profile">← Profile</a><p class="eyebrow">Open House helper</p><h1>Demo controls</h1><p>Controls for student helpers are kept separate from Jia's profile.</p>
<section class="card">
<p class="eyebrow">Acting as</p><h2><%= user.fullName %></h2>
<form method="POST" action="/demo/identity" class="merchant-picker">
<label class="field">Switch identity<select name="userId"><% Object.keys(identities).forEach(function(id) { %><option value="<%= id %>" <%= user.id === id ? 'selected' : '' %>><%= identities[id].fullName %></option><% }); %></select></label>
<button class="text-button" type="submit">Switch</button>
</form>
<small>For testing Shared Vouch between two people on this one browser.</small>
</section>
<a class="button" href="/merchant">Merchant view</a>
<section class="admin-zone"><p class="eyebrow">Admin · affects everyone</p><p>Reset clears all active visitor sessions and live demo data.</p><form method="POST" action="/reset-demo" data-confirm-reset><button class="button button--danger-outline" type="submit">Reset Demo</button></form></section>
<dialog class="sheet-dialog" data-reset-dialog aria-labelledby="reset-title"><form method="dialog"><h2 id="reset-title">Reset the entire demo?</h2><p>This clears all active visitor sessions and live demo data.</p><div class="sheet-actions"><button class="text-button" value="cancel">Cancel</button><button class="button" value="confirm">Reset Demo</button></div></form></dialog>
<%- include('partials/end', { active: '' }) %>
