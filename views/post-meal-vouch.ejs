<!DOCTYPE html>
<html lang="en">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"><title>Payment-Verified Vouch | NETS Vouch AI</title><link rel="stylesheet" href="/css/style.css"></head>
  <body><main class="prototype-stage"><section class="phone-shell">
    <div class="status-bar" aria-hidden="true"><span>9:41</span><span class="status-bar__island"></span><span class="status-bar__signals">● ◢ ▰</span></div>
    <header class="app-bar"><div class="wordmark"><span class="wordmark__nets">NETS</span><span class="wordmark__vouch">Vouch</span></div><span class="prototype-label">Prototype</span></header>
    <div class="phone-viewport"><div class="screen screen--post-meal">
      <p class="eyebrow">After lunch · Optional</p><h1>Worth a Vouch?</h1><p class="screen-lede">Would you recommend <%= order.merchantName %>?</p>
      <div class="one-tap-vouch"><span class="journey-icon" aria-hidden="true">✓</span><h2>One tap. No review required.</h2><p>Your amount is never shown and you receive no extra reward.</p></div>
      <div class="verified-definition"><span aria-hidden="true">✓</span><span><strong>Payment-Verified Vouch</strong>Confirms this simulated eligible NETS payment, not guaranteed quality.</span></div>
      <% if (alreadyCreated) { %><p class="mode-note mode-note--personalised"><strong>Vouch already saved</strong></p><% } %>
      <form class="screen-actions screen-actions--bottom" method="POST" action="/vouch">
        <button class="button button--full" type="submit" name="action" value="create" <%= alreadyCreated ? 'disabled' : '' %>>Vouch — one tap</button>
        <button class="button button--ghost button--full" type="submit" name="action" value="skip">Not now</button>
      </form>
    </div></div><div class="home-indicator" aria-hidden="true"></div>
  </section></main><script src="/js/script.js"></script></body>
</html>
