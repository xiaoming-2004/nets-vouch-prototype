<%- include('partials/start', { title: 'Merchant demo' }) %>
<p class="eyebrow">Merchant demo</p><h1><%= merchant.merchantName %></h1>
<form method="GET" action="/merchant" class="merchant-picker"><input type="hidden" name="tab" value="<%= tab %>"><label class="field">Merchant<select name="merchantId"><% merchants.forEach(function(item) { %><option value="<%= item.id %>" <%= item.id === merchant.id ? 'selected' : '' %>><%= item.merchantName %></option><% }); %></select></label><button class="text-button" type="submit">Switch</button></form>
<nav class="tabs" aria-label="Merchant sections"><% ['campaign', 'orders', 'results'].forEach(function(item) { %><a href="/merchant?merchantId=<%= merchant.id %>&tab=<%= item %>" <%- tab === item ? 'aria-current="page"' : '' %>><%= item.charAt(0).toUpperCase() + item.slice(1) %></a><% }); %></nav>
<% if (tab === 'orders') { %>
<% if (!order || order.status === 'PENDING_PAYMENT') { %><p class="card">No paid collection orders.</p><% } else { %>
<section class="card"><p class="eyebrow">Order #<%= order.orderNumber %> · <%= order.status %></p><h2><%= order.itemName %></h2><p>Simulated merchant handoff</p>
<% if (order.status === 'PAID' || order.status === 'PREPARING') { %><form method="POST" action="<%= order.status === 'PAID' ? '/merchant/start-preparing' : '/merchant/mark-ready' %>" data-single-submit><input type="hidden" name="journeyId" value="<%= order.id %>"><input type="hidden" name="merchantId" value="<%= merchant.id %>"><button class="button" type="submit"><%= order.status === 'PAID' ? 'Start preparing' : 'Mark ready' %></button></form><% } %>
<% if (order.status === 'READY') { %><p>Ready for collection ✓</p><% } %><% if (order.collected) { %><p>Collected ✓</p><% } %></section><% } %>
<% } else if (tab === 'campaign') { %>
<p class="reward"><%= availability.title %></p><p><%= Math.max(0, campaign.dailyCap - campaign.redemptionsToday) %> rewards remaining today</p>
<% if (error) { %><p class="error">Check the campaign values and try again.</p><% } %>
<form method="POST" action="/merchant/offer" class="card form-stack">
<input type="hidden" name="merchantId" value="<%= merchant.id %>">
<label class="field">Reward ($)<input name="rewardAmount" type="number" min="0" max="50" step=".01" value="<%= campaign.rewardAmount.toFixed(2) %>" required></label>
<label class="field">Daily cap<input name="dailyCap" type="number" min="1" max="1000" value="<%= campaign.dailyCap %>" required></label>
<label class="field">Start<input name="startTime" type="time" value="<%= campaign.startTime %>" required></label><label class="field">End<input name="endTime" type="time" value="<%= campaign.endTime %>" required></label>
<label class="field">Status<select name="status"><option value="ACTIVE" <%= campaign.status === 'ACTIVE' ? 'selected' : '' %>>Active</option><option value="INACTIVE" <%= campaign.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option></select></label>
<button class="button" type="submit">Save campaign</button></form>
<% } else { %>
<p class="eyebrow">Illustrative Prototype Data · this session</p>
<dl class="receipt-lines card"><div><dt>Recommendations shown</dt><dd><%= campaign.metrics.recommendationsShown %></dd></div><div><dt>Accepted</dt><dd><%= campaign.metrics.accepted %></dd></div><div><dt>QR scans</dt><dd><%= campaign.metrics.scans %></dd></div><div><dt>Completed payments</dt><dd><%= campaign.metrics.payments %></dd></div><div><dt>Attributed payments</dt><dd><%= campaign.metrics.attributedPayments %></dd></div><div><dt>Attributed purchase value</dt><dd>$<%= campaign.metrics.attributedValue.toFixed(2) %></dd></div><div><dt>Cashback released</dt><dd>$<%= campaign.metrics.rewardCost.toFixed(2) %></dd></div><div><dt>Match-to-payment conversion</dt><dd><%= campaign.metrics.recommendationsShown ? Math.round(100 * campaign.metrics.attributedPayments / campaign.metrics.recommendationsShown) : 0 %>%</dd></div></dl>
<% } %><a class="text-button" href="/home">Return to Jia</a>
<%- include('partials/end', { active: 'profile' }) %>
