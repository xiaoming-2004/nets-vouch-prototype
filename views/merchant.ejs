<%- include('partials/start', { title: 'Merchant demo', layout: 'wide' }) %>
<p class="eyebrow">Merchant demo</p><h1><%= merchant.merchantName %></h1>
<form method="GET" action="/merchant" class="merchant-picker"><input type="hidden" name="tab" value="<%= tab %>"><label class="field">Merchant<select name="merchantId"><% merchants.forEach(function(item) { %><option value="<%= item.id %>" <%= item.id === merchant.id ? 'selected' : '' %>><%= item.merchantName %></option><% }); %></select></label><button class="text-button" type="submit">Switch</button></form>
<nav class="tabs" aria-label="Merchant sections"><% ['campaign', 'results'].forEach(function(item) { %><a href="/merchant?merchantId=<%= merchant.id %>&tab=<%= item %>" <%- tab === item ? 'aria-current="page"' : '' %>><%= item.charAt(0).toUpperCase() + item.slice(1) %></a><% }); %></nav>
<% if (tab === 'campaign') { %>
<p class="reward"><%= availability.title %></p><p><%= Math.max(0, campaign.maxRewardedPaymentsPerDay - campaign.redemptionsToday) %> rewarded payments remaining today · $<%= Math.max(0, campaign.maxRewardBudgetPerDay - campaign.rewardBudgetSpentToday).toFixed(2) %> reward budget remaining today</p>
<% if (error) { %><p class="error">Check the campaign values and try again.</p><% } %>
<form method="POST" action="/merchant/offer" class="card form-stack">
<input type="hidden" name="merchantId" value="<%= merchant.id %>">
<label class="field">Reward per qualifying payment ($)<input name="rewardAmount" type="number" min="0" max="50" step=".01" value="<%= campaign.rewardAmount.toFixed(2) %>" required></label>
<label class="field">Minimum qualifying spend ($)<input name="minimumEligibleSpend" type="number" min="0" max="1000" step=".01" value="<%= campaign.minimumEligibleSpend.toFixed(2) %>" required></label>
<label class="field">Maximum rewarded payments/day<input name="maxRewardedPaymentsPerDay" type="number" min="1" max="1000" value="<%= campaign.maxRewardedPaymentsPerDay %>" required></label>
<label class="field">Maximum reward budget/day ($)<input name="maxRewardBudgetPerDay" type="number" min="0" max="100000" step=".01" value="<%= campaign.maxRewardBudgetPerDay.toFixed(2) %>" required></label>
<label class="field">Start<input name="startTime" type="time" value="<%= campaign.startTime %>" required></label><label class="field">End<input name="endTime" type="time" value="<%= campaign.endTime %>" required></label>
<label class="field">Status<select name="status"><option value="ACTIVE" <%= campaign.status === 'ACTIVE' ? 'selected' : '' %>>Active</option><option value="INACTIVE" <%= campaign.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option></select></label>
<button class="button" type="submit">Save campaign</button></form>
<section class="card qr-card">
<p class="eyebrow">Your NETS QR code</p>
<p>Display this at your counter. Customers scan it to pay with NETS Vouch.</p>
<div class="merchant-qr-wrap">
  <img class="merchant-qr-img" src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&margin=10&data=<%= encodeURIComponent(merchant.id) %>" alt="QR code for <%= merchant.merchantName %>" width="160" height="160">
  <p class="merchant-qr-id"><%= merchant.id %></p>
</div>
</section>
<section class="card">
<p class="eyebrow">Estimated maximum daily cost</p>
<p class="reward">$<%= maxDailyCost.total.toFixed(2) %></p>
<p>Highest possible cost if every reward slot is used today. Not a guarantee of profit or return — actual cost is usually lower.</p>
<dl class="receipt-lines">
<div><dt>Maximum merchant reward spend</dt><dd>$<%= maxDailyCost.rewardBudget.toFixed(2) %></dd></div>
<div><dt>Maximum NETS success fees</dt><dd>$<%= maxDailyCost.platformFee.toFixed(2) %></dd></div>
<div><dt>Maximum campaign cost</dt><dd>$<%= maxDailyCost.total.toFixed(2) %></dd></div>
</dl>
<small>Referral rewards are included within the reward budget. NETS success fee: $<%= campaign.platformFeePerAttributedPayment.toFixed(2) %> per Smart Match or Shared Vouch payment. Illustrative prototype pricing only.</small>
</section>
<% } else { %>
<p class="eyebrow">Illustrative Prototype Data · sample history, not Open House activity</p>
<% if (illustrativeMetrics && illustrativeMetrics.dailyPayments.length) { %>
<% var _trendMax = Math.max.apply(null, illustrativeMetrics.dailyPayments) || 1; var _trendDates = ['14 Sep','15 Sep','16 Sep','17 Sep','18 Sep','19 Sep','20 Sep']; %>
<section class="card trend-chart-card">
<p class="eyebrow">Sample daily payments · last 7 days</p>
<div class="trend-chart">
<% illustrativeMetrics.dailyPayments.forEach(function(v, i) { %><div class="trend-col"><div class="trend-bar" style="height:<%= Math.round(100 * v / _trendMax) %>%"></div><span class="trend-date"><%= _trendDates[i] || '' %></span></div><% }); %>
</div>
<small>Sample: <%= illustrativeMetrics.payments %> payments · $<%= (illustrativeMetrics.smartMatchSales + illustrativeMetrics.sharedVouchSales + illustrativeMetrics.directScanSales).toFixed(2) %> gross purchase sales · $<%= illustrativeMetrics.rewardCost.toFixed(2) %> merchant-funded rewards.</small>
</section>
<% } %>
<p class="eyebrow">Live demo activity · since last reset</p>
<% var _totalSales = campaign.metrics.smartMatchSales + campaign.metrics.sharedVouchSales + campaign.metrics.directScanSales; %>
<section class="card roi-summary">
<div class="roi-stat"><small>Gross purchase sales</small><b>$<%= _totalSales.toFixed(2) %></b></div>
<div class="roi-stat"><small>Attributed payments</small><b><%= campaign.metrics.smartMatchPayments + campaign.metrics.sharedVouchPayments %></b></div>
<div class="roi-stat"><small>Merchant reward spend</small><b>$<%= campaign.metrics.rewardCost.toFixed(2) %></b></div>
<div class="roi-stat"><small>Illustrative success fees</small><b>$<%= campaign.platformFeeAccrued.toFixed(2) %></b></div>
</section>
<% var _maxP = Math.max(campaign.metrics.smartMatchPayments, campaign.metrics.sharedVouchPayments, campaign.metrics.directScanPayments, 1); %>
<section class="card channel-chart">
<p class="eyebrow">Payments by channel</p>
<div class="chart-bars">
<div class="chart-row"><div class="chart-label-row"><b>Smart Match</b><small><%= campaign.metrics.smartMatchPayments %> payments · $<%= campaign.metrics.smartMatchSales.toFixed(2) %></small></div><div class="chart-track"><div class="chart-fill chart-fill--smart" style="width:<%= Math.round(100 * campaign.metrics.smartMatchPayments / _maxP) %>%"></div></div></div>
<div class="chart-row"><div class="chart-label-row"><b>Shared Vouch</b><small><%= campaign.metrics.sharedVouchPayments %> payments · $<%= campaign.metrics.sharedVouchSales.toFixed(2) %></small></div><div class="chart-track"><div class="chart-fill chart-fill--vouch" style="width:<%= Math.round(100 * campaign.metrics.sharedVouchPayments / _maxP) %>%"></div></div></div>
<div class="chart-row"><div class="chart-label-row"><b>Direct Scan</b><small><%= campaign.metrics.directScanPayments %> payments · $<%= campaign.metrics.directScanSales.toFixed(2) %></small></div><div class="chart-track"><div class="chart-fill chart-fill--direct" style="width:<%= Math.round(100 * campaign.metrics.directScanPayments / _maxP) %>%"></div></div></div>
</div>
</section>
<% if (recentPayments && recentPayments.length) { %>
<section class="card">
<p class="eyebrow">Recent live payments · NETS paid</p>
<div class="payment-feed">
<% recentPayments.forEach(function(p) { %><div class="feed-row"><span class="feed-source feed-source--<%= p.source.toLowerCase().replace('_','-') %>"><%= p.source === 'SMART_MATCH' ? 'Smart Match' : p.source === 'SHARED_VOUCH' ? 'Shared Vouch' : 'Direct Scan' %></span><span class="feed-item"><%= p.itemName || 'In-store purchase' %></span><span class="feed-meta"><%= p.date %> · <%= p.time %></span><b><%= p.displayAmount %></b></div><% }); %>
</div>
</section>
<% } %>
<dl class="receipt-lines card"><div><dt>Smart Match shown</dt><dd><%= campaign.metrics.smartMatchShown %></dd></div><div><dt>Smart Match accepted</dt><dd><%= campaign.metrics.smartMatchAccepted %></dd></div><div><dt>Smart Match payments</dt><dd><%= campaign.metrics.smartMatchPayments %></dd></div><div><dt>Smart Match sales</dt><dd>$<%= campaign.metrics.smartMatchSales.toFixed(2) %></dd></div><div><dt>Shared Vouch claims</dt><dd><%= campaign.metrics.sharedVouchClaims %></dd></div><div><dt>Shared Vouch payments</dt><dd><%= campaign.metrics.sharedVouchPayments %></dd></div><div><dt>Shared Vouch sales</dt><dd>$<%= campaign.metrics.sharedVouchSales.toFixed(2) %></dd></div><div><dt>Shared Vouch conversion</dt><dd><%= campaign.metrics.sharedVouchClaims ? Math.round(100 * campaign.metrics.sharedVouchPayments / campaign.metrics.sharedVouchClaims) : 0 %>%</dd></div><div><dt>Direct Scan payments</dt><dd><%= campaign.metrics.directScanPayments %></dd></div><div><dt>Direct Scan sales</dt><dd>$<%= campaign.metrics.directScanSales.toFixed(2) %></dd></div><div><dt>QR scans</dt><dd><%= campaign.metrics.scans %></dd></div><div><dt>Completed payments</dt><dd><%= campaign.metrics.payments %></dd></div><div><dt>Merchant reward spend</dt><dd>$<%= campaign.metrics.rewardCost.toFixed(2) %></dd></div><div><dt>Illustrative success fees accrued</dt><dd>$<%= campaign.platformFeeAccrued.toFixed(2) %></dd></div><div><dt>Smart Match conversion</dt><dd><%= campaign.metrics.smartMatchShown ? Math.round(100 * campaign.metrics.smartMatchPayments / campaign.metrics.smartMatchShown) : 0 %>%</dd></div></dl>
<% } %><a class="text-button" href="/home">Return to Jia</a>
<%- include('partials/end', { active: 'profile' }) %>
