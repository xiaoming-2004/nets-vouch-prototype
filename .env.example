# NETS Vouch AI prototype - example configuration.
#
# Copy to .env and fill in only what you need. EVERY value here is optional: with no .env at all the
# prototype runs on its curated local demo merchants, rule-based ranking and in-memory sessions, and
# the whole Open House journey works. Keys only add live discovery, AI ranking and dietary research.
#
# All of these are read server-side only. Never reference them from an EJS template or from anything
# under public/. .env is listed in .gitignore and must never be committed or shipped in a handover
# archive. The automated tests run with every one of these cleared and all providers mocked.

# ---------------------------------------------------------------------------
# Merchant discovery (Smart Match)
# ---------------------------------------------------------------------------
# Google Places API (New) is the default provider, Foursquare is the automatic fallback, and the
# curated local demo merchants are the last resort. Neither key is required.
GOOGLE_PLACES_API_KEY=your_google_places_key_here
FOURSQUARE_API_KEY=your_foursquare_key_here
# Which provider is tried first: google (default) or foursquare. The other becomes the fallback.
PLACES_PROVIDER=google

# ---------------------------------------------------------------------------
# AI ranking and craving expansion
# ---------------------------------------------------------------------------
# Groq is tried first, then OpenAI with whatever time is left, then deterministic rules. With no key
# at all Smart Match uses the rule-based ranking, which is what the test suite exercises.
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
# Model overrides. Defaults: ranking/search-intent openai/gpt-oss-20b on Groq, gpt-4o-mini on OpenAI.
GROQ_RANKING_MODEL=openai/gpt-oss-20b
GROQ_SEARCH_INTENT_MODEL=openai/gpt-oss-20b
OPENAI_RANKING_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Smart Match time budget (milliseconds)
# ---------------------------------------------------------------------------
# One overall deadline covers discovery and ranking for each request. Every
# provider call is sized from the time remaining and cancelled at the deadline.
SMART_MATCH_DEADLINE_MS=6000
# Dietary matching uses merchant-listed options only, so a dietary search costs no extra time and
# needs no separate deadline.
PLACES_REQUEST_TIMEOUT_MS=3000
SMART_MATCH_RANKING_MS=2500
SEARCH_INTENT_TIMEOUT_MS=1500

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Upstash Redis keeps sessions across serverless instances. Create a free database at
# https://console.upstash.com/ -> Redis -> Create Database, then copy the REST URL and REST token.
# Without both values the app uses MemoryStore: fine locally and for a single instance, but
# preferences are lost whenever the process restarts.
#
# Known limitation: Reset Demo's global sweep is coordinated in-process. On a single instance
# (local, or one Vercel lambda) every session is reset. Across several instances a reset does not
# reach sessions being served by another instance. See handover.md.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Signs the session cookie. Set a long random string anywhere this is reachable by other people.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port for `npm start` (default 3000).
PORT=3000
# Set to production to silence the Smart Match discovery/ranking diagnostics printed to the console.
NODE_ENV=development
