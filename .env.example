# Foursquare Places API key - the primary Smart Match nearby-discovery provider. Server-side
# only, never expose this value in EJS or public JavaScript. When absent, Smart Match falls
# back to the curated local demo merchants (the Open House prototype still works).
FOURSQUARE_API_KEY=your_key_here

# Optional OpenAI key for gpt-4o-mini Smart Match ranking (server-side only).
# When absent, Smart Match uses the built-in rule-based fallback — the demo works without it.
OPENAI_API_KEY=your_key_here
