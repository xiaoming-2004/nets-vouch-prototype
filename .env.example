# Copy to .env and fill in values. Names and placeholders only - never commit real values.

# MySQL (optional). Without these the app runs fully from session state: preferences and
# rejection feedback are simply not persisted across server restarts.
MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=netsvouch

# Session cookie signing secret (set a long random string in production).
SESSION_SECRET=

# Upstash Redis session store (required on Vercel so sessions survive cold starts;
# locally omit both to use the in-process MemoryStore).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI ranking providers (optional - rule-based fallback is used when absent).
OPENAI_API_KEY=
GROQ_API_KEY=

# Live nearby-merchant discovery (optional - demo fallback merchants are used when absent).
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
# Force one provider: google | foursquare
PLACES_PROVIDER=
