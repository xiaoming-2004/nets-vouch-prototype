# Smart Match merchant discovery (server-side only - never expose these in EJS or public JS).
# Google Places API (New) is the primary provider; Foursquare is the automatic fallback; the
# curated local demo merchants are the last resort. Neither key is required.
GOOGLE_PLACES_API_KEY=your_key_here
FOURSQUARE_API_KEY=your_key_here
# Primary discovery provider: google (default) or foursquare. The other one is the fallback.
PLACES_PROVIDER=google

# Optional OpenAI key for gpt-4o-mini Smart Match ranking (server-side only).
# When absent, Smart Match uses the built-in rule-based fallback — the demo works without it.
OPENAI_API_KEY=your_key_here

# Upstash Redis (persistent sessions across Vercel serverless instances).
# Create a free database at https://console.upstash.com/ → Redis → Create Database.
# Copy the REST URL and REST Token from the database details page.
# Without these, the app falls back to MemoryStore (fine locally, loses preferences on Vercel).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Session secret — set a strong random string in production.
SESSION_SECRET=change-me-in-production
